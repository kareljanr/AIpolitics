# Copy to telegram.env (gitignored) and fill.
# Reuse the SAME bot token as portfolio finance — different chat/topic for separation.

# Required: bot token (or leave blank if portfolio signals\.env has TELEGRAM_BOT_TOKEN)
TELEGRAM_BOT_TOKEN=

# Required for AIpolitics: SEPARATE from finance chat -1003740047943
# Create a new Telegram group "AIpolitics Radar" (or a new forum TOPIC in an existing supergroup),
# add your bot as admin, post once, then resolve chat id (see scripts/README.md).
TELEGRAM_CHAT_ID=

# Optional: forum topic thread id (only if using Topics in a supergroup)
# TELEGRAM_THREAD_ID=

# Optional: load token from portfolio if TELEGRAM_BOT_TOKEN empty
PORTFOLIO_ENV=C:\Users\karel\dev\portfolio\signals\.env
