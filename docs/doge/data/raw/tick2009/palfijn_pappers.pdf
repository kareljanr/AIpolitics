iewBox="0 0 448 512"><path class="" style="" fill="currentColor" d="M384 336l-192 0c-8.8 0-16-7.2-16-16l0-256c0-8.8 7.2-16 16-16l140.1 0L400 115.9 400 320c0 8.8-7.2 16-16 16zM192 384l192 0c35.3 0 64-28.7 64-64l0-204.1c0-12.7-5.1-24.9-14.1-33.9L366.1 14.1c-9-9-21.2-14.1-33.9-14.1L192 0c-35.3 0-64 28.7-64 64l0 256c0 35.3 28.7 64 64 64zM64 128c-35.3 0-64 28.7-64 64L0 448c0 35.3 28.7 64 64 64l192 0c35.3 0 64-28.7 64-64l0-32-48 0 0 32c0 8.8-7.2 16-16 16L64 464c-8.8 0-16-7.2-16-16l0-256c0-8.8 7.2-16 16-16l32 0 0-48-32 0z"></path></svg></div><span class="absolute -inset-[10px]"></span></div><!--]--><!--teleport start--><!--teleport end--></div></span><!--]--></div><!----></div><div class="leading-[20px] flex flex-col items-start" data-v-c02b8181><div class="flex-1 min-w-0 w-full" data-v-c02b8181><span class="body-md text-neutral-800 whitespace-nowrap align-baseline" data-v-c02b8181><!--[--><!--[--><!--]-->Oprichtingsdatum: <!--]--></span><!--[--><span class="body-md align-baseline" data-v-c02b8181>14/01/1998 <!----></span><!--]--></div><!----></div><!----><div class="leading-[20px] flex flex-col items-start" data-v-c02b8181><div class="flex-1 min-w-0 w-full" data-v-c02b8181><span class="body-md text-neutral-800 whitespace-nowrap align-baseline" data-v-c02b8181><!--[--><!--[--><!--]-->Afzonderlijke activiteit: <!--]--></span><span class="body-md align-baseline" data-v-c02b8181><!--[--><span>86.101</span><div class="inline-block px-xs" data-v-0c08b096><!--[--><div class="popup relative cursor-pointer focus:outline-none leading-[0]"><div style="width:16px;height:16px;" class="inline-flex items-center justify-center"><svg class="svg-inline--fa fa-copy fa-fw text-primary-500" style="font-size:12px;" aria-hidden="true" focusable="false" data-prefix="far" data-icon="copy" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path class="" style="" fill="currentColor" d="M384 336l-192 0c-8.8 0-16-7.2-16-16l0-256c0-8.8 7.2-16 16-16l140.1 0L400 115.9 400 320c0 8.8-7.2 16-16 16zM192 384l192 0c35.3 0 64-28.7 64-64l0-204.1c0-12.7-5.1-24.9-14.1-33.9L366.1 14.1c-9-9-21.2-14.1-33.9-14.1L192 0c-35.3 0-64 28.7-64 64l0 256c0 35.3 28.7 64 64 64zM64 128c-35.3 0-64 28.7-64 64L0 448c0 35.3 28.7 64 64 64l192 0c35.3 0 64-28.7 64-64l0-32-48 0 0 32c0 8.8-7.2 16-16 16L64 464c-8.8 0-16-7.2-16-16l0-256c0-8.8 7.2-16 16-16l32 0 0-48-32 0z"></path></svg></div><span class="absolute -inset-[10px]"></span></div><!--]--><!--teleport start--><!--teleport end--></div><span>• Activiteiten van algemene ziekenhuizen, muv geriatrische en gespecialiseerde ziekenhuizen</span><!--]--></span></div><!----></div><!--]--></div></div></div><!--[--><!--]--></div></div><!--]--><span></span></div><!--]--></div></div><div id="bodacc" class="w-full h-full min-h-[200px] rounded-reg overflow-hidden bg-white flex flex-col ring-neutral-100 ring-[0.5px] max-h-[480px]"><div class="p-md h-[80px] space-y-xs"><div class="flex h-[28px] justify-between"><h3 class="label-xl truncate">Publicaties</h3><!--[--><!--]--></div><div class="flex items-center gap-md"><h4 class="body-sm text-neutral-800 truncate flex-1">Algemeen Ziekenhuis Jan Palfijn Gent</h4><h4 class="body-sm text-neutral-800 truncate">3 publicaties</h4></div></div><hr class="h-[1px] bg-neutral-100 rounded-md w-[calc(100% - 32px)] mx-md"><div class="h-full flex-1 w-full flex flex-col min-h-0 gap-reg"><!--[--><div class="flex flex-col h-full"><div class="flex-1 overflow-y-auto p-sm"><!--[--><div class="p-sm flex rounded-md"><div class="w-[32px] flex flex-col"><div class="bg-orange-50 flex items-center justify-center rounded-sm h-[32px] w-[32px] min-h-[32px] min-w-[32px] flex-shrink-0"><div style="width:16px;height:16px;" class="inline-flex items-center justify-center"><svg class="svg-inline--fa fa-newspaper fa-fw text-orange-500" style="font-size:12px;" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="newspaper" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path class="" style="" fill="c