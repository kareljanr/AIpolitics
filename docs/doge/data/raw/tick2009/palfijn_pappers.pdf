lance_sheet":12,"related_documents":161},"2019-01-01","2019-12-31","2020-09-03",[162],{"type":119,"date":160,"date_format":48,"file_available":51,"description":12,"language":126,"file_token":163,"file_format":128},"BE_Q0JTTyM5QjY4QjM5NS0yNEE4LTQ3MUItODJCNy1DRTU4QkVCODUwQTI",{"type":119,"fiscal_year_start_date":165,"fiscal_year_start_date_format":48,"fiscal_year_end_date":166,"fiscal_year_end_date_format":48,"deposit_date":167,"deposit_date_format":48,"currency":58,"availability":123,"ratios":12,"income_statement":12,"balance_sheet":12,"related_documents":168},"2018-01-01","2018-12-31","2019-09-12",[169],{"type":119,"date":167,"date_format":48,"file_available":51,"description":12,"language":126,"file_token":170,"file_format":128},"BE_Q0JTTyM1NTNGMDU0Ri0zQ0UwLTRBQTAtOEU0MC0zNTZEMEFERjFDQjk",{"type":119,"fiscal_year_start_date":165,"fiscal_year_start_date_format":48,"fiscal_year_end_date":166,"fiscal_year_end_date_format":48,"deposit_date":172,"deposit_date_format":48,"currency":58,"availability":123,"ratios":12,"income_statement":12,"balance_sheet":12,"related_documents":173},"2019-08-29",[174],{"type":119,"date":172,"date_format":48,"file_available":51,"description":12,"language":126,"file_token":175,"file_format":128},"BE_Q0JTTyMwQ0EzMDYxNS1BNjdFLTQ4M0ItQjlEQS03Rjg1NDFCNjIwRTg",{"type":119,"fiscal_year_start_date":105,"fiscal_year_start_date_format":48,"fiscal_year_end_date":177,"fiscal_year_end_date_format":48,"deposit_date":178,"deposit_date_format":48,"currency":58,"availability":123,"ratios":12,"income_statement":12,"balance_sheet":12,"related_documents":179},"2017-12-31","2018-07-02",[180],{"type":119,"date":178,"date_format":48,"file_available":51,"description":12,"language":126,"file_token":181,"file_format":128},"BE_Q0JTTyNCNDBERjVEMy01QTBFLTQ1NjgtQjg5OS1ENTM5RkZGRkMzODY",{"type":119,"fiscal_year_start_date":183,"fiscal_year_start_date_format":48,"fiscal_year_end_date":184,"fiscal_year_end_date_format":48,"deposit_date":185,"deposit_date_format":48,"currency":58,"availability":123,"ratios":12,"income_statement":12,"balance_sheet":12,"related_documents":186},"2016-01-01","2016-12-31","2017-07-24",[187],{"type":119,"date":185,"date_format":48,"file_available":51,"description":12,"language":126,"file_token":188,"file_format":128},"BE_Q0JTTyM3OUIyNzFERS0xNzdELTRBODUtOTgwNC04NkY2NDVBMTZCOTE",11,{"results":191,"total":197},[192],{"type":193,"date":69,"date_format":48,"file_available":51,"description":194,"language":126,"file_token":195,"file_format":128,"children":196},"statutes","Gecoördineerde statuten dd.28.06.2024","BE_U1RBUE9SIzEyNTM2MTY",[],1,{"results":199,"total":115},[],{"results":201,"total":111},[202,212,222],{"categories":203,"date":206,"date_format":48,"source":207,"content":12,"id":208,"link":209,"label":210,"file_token":211},[204,205],"Kapitaal, Aandelen","Ontslagen, Benoemingen","2024-08-13","Belgisch Staatsblad","2024-08-13\u002F0120540","https:\u002F\u002Fwww.ejustice.just.fgov.be\u002Ftsv_pdf\u002F2024\u002F08\u002F13\u002F24120540.pdf","KAPITAAL - AANDELEN - ONTSLAGEN - BENOEMINGEN","BE_TU9OSVRPUiMvdHN2X3BkZi8yMDI0LzA4LzEzLzI0MTIwNTQwLnBkZg",{"categories":213,"date":216,"date_format":48,"source":207,"content":217,"id":218,"link":219,"label":220,"file_token":221},[214,215],"Maatschappelijke zetel","Statuten","2019-09-17","Mod DOC 19.01 - AL\n\nIn de bijlagen bij het Belgisch Staatsblad bekend te maken kopie na neerlegging van de akte ter griffie\n\nAnH um\n\nOndernemingsnr 0262.926.616\n\nNaam\n\n(voluit): Algemeen Ziekenhuis Jan Palfijn Gent\n\n(verkort): A.Z. JAN PALFIJN GENT\n\nRechtsvorm: OCMW Vereniging\n\nVolledig adres v.d. zetel: Henri Dunantlaan 5\n\nDe 9000 Gent\n\n: Onderwerp akte : Authentieke vaststelling statuten\n\nUit de akte verleden op 8 juli 2019 voor Jeroen Parmentier, notaris in de CVBA “NOTAS, geassocieerde: notarissen”, met zetel te 9000 Gent, Kouter 27, te registreren, blijkt dat volgende statuten werden aangenomen; ‘door de autonome verzorgingsinstelling “ALGEMEEN ZIEKENHUIS JAN PALFIJN GENT, autonome. verzorgingsinstelling”, in het kort “AZ. JAN PALFIJN GENT, A.V”, met maatschappelijke zetel te 9000 Gent, ‘Henri Dunantlaan 5, ondernemingsnummer 0262.926.616, RPR Gent afdeling Gent: | TITEL 1: BENAMING, VOORWERP, ZETEL EN DUUR\n\n: Artikel 1. Benaming !\n\nDe vereniging draagt de naam «ALGEMEEN ZIEKENHUIS JAN PALFIJN GENT, in het kort; \\“A.Z. JAN PALFIJN GENT’. Haar benaming wordt voorafgegaan of gevolgd door de leesbaar en voluit ‘geschreven woorden «vereniging van publiek recht onderworpen aan deel 3, titel 4, hoofdstuk 3, van het decreet: ‘over hef lokaal bestuur, autonome verzorgingsinstelling» of de afkorting “A, V.”, : Artikel 2. Zetel\n\nDe zeiel van de vereniging is gevestigd te 9000 Gent, Watersporilaan 5.\n\nDe raad van bestuur van de vereniging kan één of meer uitbatingszetels instellen of aanhouden. Artikel 3. Juridische vorm van de vereniging en definities\n\n81. De vereniging werd opgericht als een openbaar bestuur overeenkomstig de bepalingen van Hoofdstuk xii\n\nivan de Organieke Wet op de Openbare Centra voor Maatschappelijk Welzijn van acht juli negentienhonderd. ‘zesenzeventig, en haar werking wordt onderworpen aan het decreet over het lokaal bestuur van 22 december; ‘201 7 (hierna “decreet lokaal bestuur” genoemd).\n\n§2. Als er geen specifieke meerderheid van stemmen in deze statuten staat vermeld, dan wordt de volstrekte! ‘meerderheid verondersteld. Onder volstrekte meerderheid van stemmen wordt verstaan: meer dan de helft van: ‘de uitgebrachte stemmen, waarbij geen rekening wordt gehouden met onthoudingen om de numerieke: ‘meerderheid te berekenen. ‘\n\nAls er bijzondere meerderheid van stemmen in deze statuten staat vermeld, dan wordt daaronder verstaan:: ‘het breukdeel van de uitgebrachte stemmen dat wordt vermeld in de wet of in de statuten, waarbij geen rekening ‘wordt gehouden met onthoudingen om de numerieke meerderheid te berekenen. Bij de vaststelling van een meerderheid van stemmen worden niet gehele getallen altijd afgerond naar boven: 83. De leden-deelgenoten vormen de algemene vergadering. ;\n\nDe leden-deelgenoten zijn rechtspersonen en worden in de algemene vergadering vertegenwoordigd door. Jeden-afgevaardigden. ‘\n\nDe leden-afgevaardigden zijn natuurlijke personen, al dan niet handelend via een rechtspersoon, aangeduid ‘door de leden-deelgenoten.\n\n84, De bestuurders-deelgenoten en de onafhankelijke bestuurders vormen de raad van bestuur.\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\nr\n\nVoor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\nMod DOC 19.01 - AL\n\nDe bestuurders-deelgenoten zijn rechtspersonen en worden in de raad van bestuur vertegenwoordigd door bestuurders-afgevaardigden.\n\nDe bestuurders-afgevaardigden zijn natuurlijke personen, al dan niet handelend via een rechtspersoon, aangeduid door de bestuurders-deelgenoten.\n\nDe onafhankelijke bestuurders zijn natuurlijke personen, al dan niet handelend via een rechtspersoon, benoemd door de algemene vergadering op voordracht van de raad van bestuur.\n\nArtikel 4. Doel\n\n. De vereniging heeft de uitoefening van ziekenhuisactiviteiten tot doel.\n\nIn dit kader heeft de vereniging tot doel:\n\n— _om een openbare ziekenhuisdienst te exploiteren, met het oog op het aanbod van patiëntgeoriënteerde, toegankelijke, kwaliteitsvolle en veilige zorg vanuit een pluralistische visie;\n\n— _om de missie van het ziekenhuis te realiseren vanuit volgende visie:\n\no de aanbieding van een veilige, efficiënte en effectieve zorg in een aangename en geruststellende omgeving\n\no de bouw aan een excellente zorgreputatie, samen met onze artsen, die het AZ. Jan Paffijn Gent positioneert als een krachtig en performant ziekenhuis zowel autonoom als op netwerkniveau;\n\no inspelen op maatschappelijke tendensen en op veranderende zorgnoden bij onze patiënten; de patiënt erkennen als volwaardige partner in zijn zorgtraject;\n\no de gelijkheid van de patiënten vooropstellen ongeacht hun sociale, financiële of verzekerbaarheidstoestand en ongeacht levensbeschouwing, geaardheid of afkomst; o de naleving van alle wettelijke bepalingen en tariefzekerheid;\n\no om zorg te bieden binnen een ethisch kader, zonder winstbejag nach therapeutische hardnekkigheid;\n\n— _om een aantrekkelijke werkgever te zijn voor onze medewerkers die zich engageren om zorg te verlenen in lijn met onze waarden;\n\n- de verzekering van het voortbestaan van de activiteiten van de vereniging binnen het uitgetekend wettelijk kader, waarbij zorgvraag en zorgaanbod op elkaar worden afgestemd en waarbij efficiëntie en effectiviteit in alle processen een continu aandachtspunt is;\n\n— _de ontwikkeling van nieuwe diensten en technologieën die effectief inspelen op nieuwe behoeften;\n\n— het verschil maken ten aanzien van al onze stakeholders, door een open dialoog en gerichte communicatie-aanpak.\n\nArtikel 5. Duur\n\nDe vereniging werd opgericht voor een termijn van dertig (30) opeenvolgende jaren, ingaande op één januari negentienhonderd achtennegentig. Ze werd vervroegd verlengd voor een termijn van dertig (30) opeenvolgende jaren ingaande op één (1) januari tweeduizend en twaalf (2012) en eindigend op eenendertig (31) december tweeduizend eenenveertig (2041).\n\nTITEL 2: AANDUIDING, TOETREDING, UITTREDING EN UITSLUITING VAN LEDEN-DEEL GENOTEN Artikel 6. Aanduiding van de leden-deelgenoten\n\nDe vereniging heeft de volgende leden-deelgenoten:\n\n(1) het Openbaar Centrum voor Maatschappelijk Welzijn van Gent, te 9000 Gent, Onderbergen 86 (hierna het OCMW genoernd);\n\n(2) de vereniging zonder winstoogmerk “institut moderne” te 9000 Gent, Koningin Fabiolalaan 57 (hierna institut Moderne vzw genoemd).\n\nArtikel 7. Toetreding\n\nTot de vereniging kunnen nieuwe leden-deelgenoten toetreden. De toetreding van nieuwe leden-deelgenoten gebeurt op voordracht van de raad van bestuur. De algemene vergadering keurt de toetreding goed. Elke beslissing tot toetreding van een lid-deelgenoot vereist bovendien de voorafgaande instemming van de leden- deelgenoten,\n\nDe algemene vergadering beslist over de inbreng en de bijdragen van een toetredende fid-deelgenoot, inclusief de rechten die de leden van de vereniging kunnen laten gelden op de inbrengen die zij zouden gedaan hebben bij de toetreding tot de vereniging of tijdens hun deelgenootschap. De toetreding van een lid-deelgenoot mag er niet toe leiden dat het OCMW minder dan éénenvijftig (51) procent van de stemmen zal bezitten ín de algemene vergadering en in de raad van bestuur. Een toetreding die afbreuk doet aan het voorgaande kan door de algemene vergadering niet worden goedgekeurd. Artikel 8. Uittreding\n\nHet lid-deeigenoot dat uit de vereniging wenst te treden, deelt dit ree aan de raad van bestuur met een per post aangetekende brief. In dit geval zal het lid-deelgenoot met ingang van één (1) januari van het derde boekjaar volgend op het schrijven, van rechtswege ophouden deel uit te maken van de vereniging. Gedurende de eerste tien (10) jaren kunnen de leden-deelgenoten evenwel niet uittreden en kan een aangetekend ontslagschrijven geen enkel rechtsgevolg hebben. Voor de leden-deelgenoten die toetreden tot de vereniging, starten deze tien (10) jaren op de datum van de algemene vergadering die de toetreding goedkeurt.\n\nOo\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f£\n\n+\n\nVpor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsbiad\n\nMod DOC 19.91 - AL\n\nEen lid-deelgenoot kan evenwel toch uittreden bij wijziging van de doeleinden van de vereniging, zoals bepaald in artikel 483 decreet lokaal bestuur.\n\nArtikel 9, Uitsluiting\n\nDe uitsluiting van een lid-deelgenoot kan, onverminderd de vordering van schadevergoeding, slechts uitgesproken worden wegens de niet-uitvoering van zijn verbintenissen ten aanzien van de vereniging, zoals deze verbintenissen mede blijken uit het tussen de leden-deelgenoten, met het oog op de oprichting van de vereniging, afgesloten protocol. Dit protocol werd als bijlage toegevoegd aan de beslissing van de raad voor maatschappelijk welzijn van het OCMW van Gent die op haar beurt aan de notariële oprichtingsakte is gehecht na ondertekening \"ne varietur’ door de leden-deeigenoten en door de notaris, teneinde er één geheel mee uit te maken en om er samen mee te worden geregistreerd.\n\nOver de uitsluiting wordt, bij gemotiveerd besluit, beslist door de algemene vergadering. De algemene vergadering dient het betrokken lid-deelgenoot voorafgaandelijk behoorlijk op te roepen en hem de mogelijkheid te bieden om gehoord te worden.\n\nTITEL 3: INBRENGEN EN BIJDRAGEN Artikel 10. Inbrengen\n\nDe inbrengen van leden-deelgenoten zijn beschreven in de authentieke akte van 14 januari 1998, gepubliceerd in de bijlage van het Belgisch Staatsblad van 2 april 1998.\n\nArtikel 11, Vergoedingen bij uittreding en uitsluiting\n\n$ 1. De uitgesloten of uittredende leden-deelgenoten zullen worden vergoed: a) voor de inbreng van de exploitatierechten van het ziekenhuis en de daarmee gepaard gaande ziekenhuisbedden door de uitkering van een schadeloosstelling die zal bepaald worden door een onafhankelijke derde, die deskundig is op het domein van ziekenhuisfinanciering en die wordt aangeduid door alle deefgenoten gezamenlijk. De bijhorende kosten van de onafhankelijke derde worden in gelijke delen verdeeld tussen alle deelgenoten. De vergoeding wordt gespreid terugbetaald op een wijze die de ziekenhuisexploitatie niet in het gedrang brengt;\n\nb) voor de roerende inbreng: volgens de waarde zoals vastgesteld ín de laatste jaarrekening van de vereniging die de gebeurtenis voorafgaat.\n\nDe erfpacht op het desbetreffende onroerende goed zal van rechtswege vervallen en de onroerende goederen zuilen aan het uittredende of uitgesloten lid-deelgenoot, of aan wie ze behoren, vrij en onbelast ter beschikking worden gesteld per één (1) januari van het jaar dat op de uittreding of uitsluiting volgt. De als vergoeding verschuldigde betalingen zijn opeisbaar één (1) jaar na de gebeurtenis. 82. Onderhavige regeling geldt zonder afbreuk te doen aan artikel 483 decreet lokaal bestuur. TITEL 4: DE ALGEMENE VERGADERING\n\nArtikel 12. Principe\n\nDe regelmatig opgeroepen en samengestelde atgemene vergadering vertegenwoordigt de leden-deelgenoten van de vereniging en haar beslissingen zijn binnen de perken van het decreet lokaal bestuur en van onderhavige statuten bindend voor eenieder.\n\nArtikel 13. Samenstelling\n\n$1, De algemene vergadering is samengesteld uit de leden-deelgenoten van de vereniging. De leden-deefgenoten van de vereniging worden in de algemene vergadering vertegenwoordigd door (eden. afgevaardigden en dit als volgt:\n\n— hef OCMW wordt vertegenwoordigd door dertien (13) leden-afgevaardigden aangeduid door de raad voor maatschappelijk welzijn van het OCMW;\n\n— Institut Moderne vzw wordt vertegenwoordigd door drie (3) leden-afgevaardigden aangeduid door Institut Moderne vzw;\n\nDe leden-afgevaardigden worden door iedere lid-deelgenoot aangeduid volgens de wettelijke en statutaire bepalingen die op hem van toepassing zijn. De leden-afgevaardigden van het OCMW dienen leden te zijn van de raad voor maafschappelijk welzijn van het OCMW.\n\nDe leden-afgevaardigden oefenen een mandaat uit gedurende een periode van zes (6) jaar, onbeperkt hernieuwbaar. De leden-afgevaardigden die de hoedanigheid hebben van OCMW-raadslid oefenen een mandaat uit voor een periode gelijk aan hun mandaat in de raad voor maatschappelijk welzijn van het OCMW. De hernieuwing van de leden-afgevaardigden, zal door de leden-deelgenoten gebeuren telkens op het einde van het mandaat van zes (6) jaar. De hernieuwing van de leden-afgevaardigden die de hoedanigheid hebben van OCMW-raadslid, zal uiterlijk twee (2) maanden na de installatie van de nieuwe raad voor maatschappelijk welzijn gebeuren. De aangeduide leden-afgevaardigden oefenen hun mandaat uit tot de installatie van de nieuwe afgevaardigden.\n\n$2. Het mandaat van een lid-afgevaardigde in de algemene vergadering eindigt evenwel vroegtijdig in de volgende gevallen:\n\n— _ voor de leden-afgevaardigden van het OCMW door de beëindiging van hun mandaat als lid van de raad voor maatschappelijk welzijn van het OCMW tijdens een lopende legislatuur;\n\n~ van rechtswege door de intrekking van het mandaat van het lid-afgevaardigde door het lid- deelgenoot;\n\n— bij vrijwillig ontslag, bij overlijden, bij onbekwaamverklaring en in andere gevallen waarin het lid-afgevaardigde niet langer in staat is zijn mandaat uit te voeren.\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\noor-\n\nbetouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\nMod DOC 19.01 - AL\n\nHet bovensiaande moet door het lid-deelgenoot met een per post aangetekende brief worden meegedeeld aan de voorzitter van de algemene vergadering. Binnen de drie (3) maanden vanaf de datum van de aangetekende brief wordt door het desbetreffende lid-deelgenoot een nieuwe lid-afgevaardigde aangeduid, volgens de wettelijke en statutaire bepalingen die op hem van toepassing zijn. Het aldus aangeduide lid- afgevaardigde beëindigt het mandaat van diegene die hij vervangt. In afwachting van deze aanduiding kan de algemene vergadering van de vereniging rechtsgeldig vergaderen, beraadslagen en besluiten. De leden-deelgenoten kunnen hun leden-afgevaardigden tijdelijk vervangen door plaatsvervangers, conform de wettelijke en statutaire bepalingen die op hen van toepassing zijn. De modaliteiten van deze plaatsvervanging worden bepaald ín het huishoudelijk reglement.\n\n83. In geval van foetreding, uittreding of uitsluiting van leden-deelgenoten zal het aantal leden-afgevaardigden van elk lid-deelgenoot in de algemene vergadering worden vastgesteld via een statutenwijziging. Het aantal leden-afgevaardigden wordt bepaald in verhouding tot ieders inbreng in de vereniging. §4, De bestuurder-directeur wordt, als lid-expert, uitgenodigd om de algemene vergadering bij te wonen met raadgevende sten,\n\nDe algemene vergadering mag voor advies over bepaalde punten ook worden bijgewoond door andere personert, waarvan de aanwezigheid, bij beslissing van de algemene vergadering, als nuttig of noodzakelijk wordt geacht en dit volgens de modaliteiten bepaald in het huishoudelijk reglement. Zij worden leden-experten ad hoc genoemd.\n\nDe leden-experten ad hoc mogen niet aanwezig zijn bij de beraadslaging en de stemming. Artikel 14, Bevoegdheden\n\n81. De algemene vergadering heeft geen andere bevoegdheden dan deze die haar door de vigerende wefgeving en door huidige statuten zijn toegekend.\n\n82. De algemene vergadering heeft de volgende bevoegdheden:\n\n— _de wijziging van de statuten;\n\n— de toetreding van nieuwe leden-deelgenoten en de uitsluiting van leden-deelgenoten;\n\n— _de bepaling van het aantal bestuurders-deelgenoten en onafhankelijke bestuurders;\n\n— _de benoeming en de afzetting van de onafhankelijke bestuurders;\n\n- de goedkeuring van de begroting:\n\n- de goedkeuring van de jaarrekening;\n\n- de goedkeuring van het meerjarenplan en de aanpassing(en) aan het meerjarenplan;\n\n- de bepaling van de opvolgingsrapportering met stand van zaken van de uitvoering van het meerjarenptan;\n\n— de goedkeuring van het zorgstrategisch plan. Het zorgstrategisch plan moet bovendien worden goedgekeurd door de raad voor maatschappelijk welzijn van het OCMW;\n\n— de aanduiding van de bedrijfsrevisor en de bepaling van zijn vergoeding;\n\n— de kwijting aan de bedrijfsrevisor en aan de bestuurders-deelgenoten en de onafhankelijke bestuurders;\n\n— de goedkeuring van de samenwerkings- en beheersovereenkomsten met de leden-deelgenoten;\n\n— _de vroegtijdige ontbinding van de vereniging, de aanstelling van één of meer vereffenaars, de bepaling van hun bevoegdheden en de bepaling van de bestemming van het netto-actief in geval van ontbinding van de vereniging;\n\n— de verlenging van de duur van de vereniging;\n\n— de bepaling van het huishoudelijk reglement van de vereniging op voorstel van de raad van bestuur. Dat reglement kan bepalen dat aan de leden-afgevaardigden, aan de bestuurders-afgevaardigden en\u002Fof aan de onafhankelijke bestuurders presentiegelden toegekend worden, evenwel binnen het vigerend wettelijk kader;\n\n— alle materies waarin de wetgeving of deze statuten een beslissing van de algemene vergadering vereisen;\n\n83. De beslissingen over de wijziging van de statuten, over de vroegtijdige ontbinding en over de verlenging van de duur van de vereniging, worden genomen op basis van een verslaggeving na bespreking op de raad van bestuur.\n\nArtikel 15, Voorzitterschap en functies\n\n$1, De voorzitter van de algemene vergadering en de tweede ondervoorzitter van de algemene vergadering worden benoemd door de algemene vergadering uit de leden-afgevaardigden van het lid-deelgenoot “het OCMW”.\n\nDe eerste ondervoorzitter van de algemene vergadering wordt benoemd door de algemene vergadering uit de leden-afgevaardigden van het lid-deelgenoot “Institut Moderne vzw”.\n\nDe bevoegdheden van de voorzitter van de algemene vergadering, de eerste ondervoorzitter en de tweede ondervoorzitter worden geregeld in de statuten en in het huishoudelijk reglement. 82. De voorzitter van de algemene vergadering zit de algemene vergadering voor. Bij verhindering van de voorzitter van de algemene vergadering wordt de vergadering voorgezeten door de tweede ondervoorzitter van de algemene vergadering en bij verhindering van deze laatste door de eerste ondervoorzitter van de algemene vergadering.\n\nIndien zowel de voorzitter, als de tweede en de eerste ondervoorzitter verhinderd zijn, zit het door de voorzitter - of bij gebreke door de tweede ondervoorzitter - aangeduide lid-afgevaardigde de algemene vergadering voor.\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\fx\n\nVoor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\nMod DOC 19,01 - AL\n\n83. De verslaggever van de vergadering neemt het secretariaat van de algemene vergadering wear. De verslaggever is geen lid van de algemene vergadering of de raad van bestuur en is gebonden door een discretieplicht.\n\nHij\u002Fzij is belast met de opmaak van de notulen, die rechtsgeldig door hemzeff\u002Fhaarzelf en door de voorzitter van de algemene vergadering worden ondertekend.\n\nArtikel 16, Samenkomst en bijeenroeping\n\nDe algemene vergadering vindt minstens twee (2) maal per jaar plaats, respectievelijk ter goedkeuring van de begroting en van de jaarrekening.\n\nTot de bijeenroeping van een buitengewone algemene vergadering kan door de raad van bestuur beslist worden telkens deze dit noodzakelijk acht. Op aanvraag van minstens één derde (1\u002F3) van de leden- afgevaardigden is de voorzitter van de algemene vergadering ertoe gehouden een buitengewone algemene vergadering bijeen te roepen, die met de agendapunten door hen bepaald, eventueel door hem aangevuld, moet plaatshebben binnen de vijftien (15) dagen na de aanvraag.\n\nDe algemene vergadering heeft plaats op de zetel van de vereniging of op enige andere in het huishoudelijk reglement voorziene plaats.\n\nArtikel 17. Wijze van bijeenroeping en agenda\n\nDe algemene vergadering wordt bijeengeroepen door de voorzitter van de algemene vergadering of bij zijn verhindering door de tweede ondervoorzitter van de algemene vergadering en bij de verhindering van deze laatste door de eerste ondervoorzitter van de algemene vergadering. De bijeenroeping verloopt via een uitnodiging met agendapunten, die elektronisch en\u002Fof per post wordt bezorgd aan elk lid-afgevaardigde. Elk lid-afgevaardigde kiest de wijze van bezorging en geeft hierbij het adres (elektronisch adres of verblijfsadres) op. De agenda wordt op hetzelfde moment op elektronische wijze of per post aan de voorzitter van het OCMW bezorgd. De uitnodiging met agendapunten wordt tenminste tien (10) kalenderdagen voor de dag van de vergadering bezorgd. Deze termijn kan worden ingekort in spoedeisende gevallen tot vijf (5) kalenderdagen. Deze agenda wordt opgesteld door de voorzitter van de algemene vergadering na overleg met de voorzitter van de raad van bestuur doch moet worden aangevuld met de punten, waarvan één of meer leden- afgevaardigden bij verzoek aan de voorzitter van de algemene vergadering gericht, ten minste vijf (5) kalenderdagen voor de vergadering, de behandeling vragen.\n\nDe documenten over de agendapunten worden meegestuurd met de uitnodiging of liggen minstens - behoudens in spoedeisende gevallen - tien (10) kalenderdagen vooraf ter inzage op de zetel van de vereniging. De documenten over de begroting en de jaarrekening worden in elk geval samen met de uitnodiging en de agenda verstuurd.\n\nDe algemene vergadering mag enkel beraadslagen over de punten die op de agenda staan, behalve in geval van dringende noodzakelijkheid, die door ten minste twee derde (2\u002F3) van de aanwezige of vertegenwoordigde leden-afgevaardigden moet worden vastgesteld.\n\nArtikel 18. Stemgerechtigdheid\n\nElk lid-deelgenoot heeft evenveel stemmen als het aantal aanwezige of vertegenwoordigde leden- afgevaardigden. De leden-deelgenoten beschikken over volgend aantal sternmen:\n\n— _het OCMW beschikt over dertien (13) stemmen;\n\n— _ Institut Moderne vzw beschikt over drie (3) stemmen;\n\nLeden-afgevaardigden die niet op de vergadering aanwezig kunnen zijn, kunnen door andere leden- afgevaardigden van dezelfde deelgenoot worden vertegenwoordigd. Elk lid-afgevaardigde kan maximaal één (1) volmacht dragen.\n\nIndien geen enkel lid-afgevaardigde aanwezig kan zijn, kan geen volmacht worden gegeven aan de leden- afgevaardigden van de andere deelgenoten, Het betrokken lid-deelgenoot is in zulk geval niet vertegenwoordigd en dus afwezig op de vergadering.\n\nArtikel 19, Aanwezigheidsquorum\n\n$1. Behalve voor de aangelegenheden, bedoeld door §2 van dit artikel kan de algemene vergadering slechts geldig beraadslagen en besluiten indien ten minste de helft (1\u002F2) van de leden-afgevaardigden aanwezig of vertegenwoordigd is.\n\nindien het voormelde minimum niet bereikt is, wordt binnen de maand een nieuwe algemene vergadering bijeengeroepen, die geldig beslist over de punten die voor de tweede maal op de agenda worden geplaatst, welke ook het aantal aanwezige of vertegenwoordigde leden-afgevaardigden mogen zijn. 82. Om geldig fe beraadslagen en te besluiten over de toetreding van rechispersonen die geen verzorgingsinstellingen zijn, de uitsluiting van leden-deelgenoten, het ontslag van de onafhankelijke bestuurders conform artikel 484, 82, laatste lid van het decreet lokaal bestuur, de wijziging van statuten, de verlenging van duur of de vroegtijdige ontbinding van de vereniging, moet ten minste twee derde (2\u002F3) van het totale aantal leden- afgevaardigden aanwezig of vertegenwoordigd zijn.\n\nWanneer het gaat om een vergadering waarin een wijziging van de statuten zal worden besproken, dient de uitnodiging of de agenda in elk geval de tekst van de voorgestelde wijzigingen te bevatten. indien de vereiste twee derde (2\u002F3) van de leden-efgevaardigden niet aanwezig of vertegenwoordigd is na een eerste bijeenraeping, wordt gehandeld overeenkomstig het laatste lid van §1 van dit artikel. In de uitnodiging tot de nieuwe vergadering moet de aandacht van de leden-afgevaardigden worden gevestigd op de draagwijdte van deze bepaling. .\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\nVoor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\nMod DOC 49.01 - AL\n\nArtikel 20. Vereiste meerderheden\n\n$1. De beslissingen van de algemene vergadering, waaronder de beslissing over de toetreding van een rechtspersoon die een verzorgingsinstelling is, worden genomen bij volstrekte meerderheid van de uitgebrachte sfemmen, zoals bepaald in artikel 3, $2 van deze statuten.\n\nIn afwijking van het voorgaande lid, worden de volgende beslissingen genomen met een meerderheid van twee derde (2\u002F3) van het aantal uitgebrachte stemmen:\n\n— de toetreding van rechtspersonen die geen verzorgingsinstellingen zijn;\n\n~ de uitsluiting van leden-deelgenoten;\n\n— _het ontslag van de onafhankelijke bestuurders conform artikel 484, $2, laatste lid van het decreet lokaal bestuur;\n\n- __de wijziging van statuten;\n\n— de verlenging van duur;\n\n- de vroegtijdige ontbinding van de vereniging.\n\n82. Bij staking van stemmen is de stem van het lid-afgevaardigde die de algemene vergadering voorzit, doorslaggevend.\n\n§3. Bij toepassing van artikel 482 van het decreet lokaal bestuur is elke beslissing tot wijziging van de statuten die een verzwaring van de verplichtingen of een vermindering van de rechten van de leden-deeigenoten meebrengt, tot toelating van een nieuw lid-deelgenoot, tot verlenging van de duur van de vereniging of tot vrijwillige ontbinding van de vereniging onderworpen aan de voorafgaandelijke instemming van alle leden- deelgenoten.\n\n§4. Indien de openbare rechtspersonen over minimaal een derde (1\u002F3) van de stemmen beschikken dan moet de begroting worden goedgekeurd door een meerderheid van de openbare rechtspersonen conform artikel 498, derde lid decreet lokaal bestuur.\n\nArtikel 21. Wijze van stemmen\n\nDe stemmingen verlopen mondeling. De stemming is evenwel geheim wanneer het gaat om de benoeming van natuurlijke personen.\n\nVoor iedere benoeming wordt tot een afzonderlijke stemming overgegaan. Índien de meerderheid niet werd verkregen bij de eerste stembeurt, heeft herstemming plaats voor de twee (2) kandidaten die de meeste stemmen hebben verkregen.\n\nArtikel 22. Modaliteiten van samenkomen\n\nDe bijeenkomsten van de algemene vergadering zijn in principe openbaar. Artikel 28 decreet lokaal bestuur ís van toepassing op deze vergaderingen.\n\nArtikel 23. Aanwezigheden\n\nAlle personen die de vergadering bijwonen op uitnodiging van de algemene vergadering, tekenen de aanwezigheidslijst met aanduiding van de hoedanigheid waarin zij optreden. De aanwezigheidslijst wordt ondertekend op het ogenblik van hun aankomst en deze maakt deel uit van de notulen van de vergadering. indien voornoemde persoon slechts gedurende een gedeelte van de vergadering aanwezig ís, wordt in de notulen melding gemaakt van het ogenblik waarop hij de vergadering bijwoont of verlaat. De aanwezigheidslijst geldt tot bewijs van het tegendeel.\n\nArtikel 24. Onverenigbaarheden\n\nHet bepaalde in artikel 27 decreet lokaal bestuur is van toepassing op de leden-afgevaardigden en in voorkomend geval op de leden-experten.\n\nArtikel 25, Notulen en afschriften\n\nDe beslissingen van de algemene vergadering worden genotuleerd door de verslaggever van de algemene vergadering. .\n\nDe notulen worden na goedkeuring door de algemene vergadering, ondertekend door de voorzitter van de algemene vergadering en de verslaggever. De notulen worden beheerd door de verslaggever van de algemene vergadering.\n\nAfschriften van of uittreksels uit de notulen worden ondertekend door de voorzifter van de algemene vergadering of bij zijn verhindering door de eerste ondervoorzitter of de tweede ondervoorzitter van de algemene vergadering en door de verslaggever.\n\nDe notuten liggen op de zetel van de vereniging ter inzage van de leden-afgevaardigden. Deze documenten kunnen ook elektronisch ter beschikking worden gesteld, indien een lid-afgevaardigde daartoe de wens uitdrukt. De leden-afgevaardigden, de leden-experten en de leden-experten ad hoc zijn onder verwijzing naar artikel 458 van het strafwetboek tot geheimhouding verplicht over de informatie uit een algemene vergadering die achter gestoten deuren heeft plaatsgevonden en over alle aangelegenheden behandeld door de andere organen van de vereniging.\n\nDerden kunnen aan de verslaggever een schriftelijk verzoek richten om inzage te verkrijgen van de notulen. De voorzitter van de algemene vergadering oordeelt over het gevolg dat aan dergelijk verzoek gegeven dient te worden overeenkomstig het decreet betreffende de openbaarheid van bestuur. De verslaggever van de vereniging zorgt voor de door de wet voorgeschreven publicaties in het Belgisch Staatsblad.\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\n*\n\nVoor-\n\nbehouden\n\naan het\n\nBeigisch\n\nStaatsbiad\n\nMod DOC 19.01 - AL\n\nTITEL 5: DE RAAD VAN BESTUUR\n\nArtikel 26, Samenstelling\n\n$1. De vereniging wordt bestuurd door een raad van bestuur. De raad van bestuur is samengesteld uit de bestuurders-deelgenoten en de onafhankelijke bestuurders.\n\n$2. De bestuurders-deelgenoten worden in de raad van bestuur vertegenwoordigd door bestuurders- afgevaardigden en dit als volgt:\n\n— het OCMW wordt vertegenwoordigd door vier (4) bestuurders-afgevaardigden aangeduid door de raad voor maatschappelijk welzijn van het OCMW,\n\n— Institut Moderne vzw wordt vertegenwoordigd door één (1) bestuurder-afgevaardigde aangeduid door Institut Moderne vzw;\n\nDe bestuurders-afgevaardigden worden door iedere bestuurder-deelgenoot aangeduid volgens de wettelijke en statutaire bepalingen die op hem van toepassing zijn.\n\nDe bestuurders-afgevaardigden van het OCMW worden door de raad voor maatschappelijk welzijn aangeduid bij geheime stemming en in één enkele stemronde. Elk lid van de raad voor maatschappelijk welzijn beschikt daarbij over één stem. Bij staking van stemmen is de jongste kandidaat in jaren verkozen. De bestuurders-efgevaerdigden oefenen een mandaat uit gedurende een periode van zes (6) jaar, onbeperkt hernieuwbaar. .\n\nHet mandaat van bestuurder-afgevaardigde eindigt ook vroegtijdig in de volgende gevallen;\n\n— nadat de raad voor maatschappelijk welzijn overeenkomstig de toepasselijke wetgeving opnieuw is geïnstalleerd en zijn bestuurders-afgevaardigden heeft aangeduid;\n\n— _ voor de bestuurders-afgevaardigden van het OCMW die OCMW-raadslid zijn door de beëindiging van hun mandaat als OCMW-raadslid tijdens een lopende legislatuur;\n\n— van rechtswege door de intrekking van het mandaat van de bestuurder-afgevaardigde door de bestuurder-deelgenoot;\n\n~ _ bij vrijwillig ontslag, bij overlijden, bij onbekwaamverklaring en in andere gevallen waarin de bestuurder- afgevaardigde niet langer in staat is zijn mandaat uit te voeren.\n\nHet bovenstaande moet door de bestuurder-deelgenoot met een per post aangetekende brief worden meegedeeld aan de voorzitter van de raad van bestuur. Binnen de drie (3) maanden vanaf de datum van de aangetekende brief wordt door de desbetreffende bestuurder-deelgenoot een nieuwe bestuurder-atgevaardigde aangeduid, volgens de wettelijke en statutaire bepalingen die op hem van toepassing zijn. De aldus aangeduide bestuurder-afgevaardigde beëindigt het mandaat van diegene die hij vervangt. In afwachting van deze aanduiding kan de raad van bestuur rechtsgeldig vergaderen, beraadslagen en besluiten. De bestuurders-deelgenoten kunnen in een tijdelijke vervanging van hun bestuurders-afgevaardigden voorzien, conform de wettelijke en statutaire bepalingen die op hen van toepassing zijn. De bestuurder- deelgenoot deelt de identiteit van de persoon die voor deze tijdelijke vervanging zal instaan mee aan de voorzitter van de raad van bestuur. Deze mededeling gebeurt schriftelijk ten laatste 72 uur voor het aanvangsuur dat vermeld is op de uitnodiging van de vergadering.\n\nin geval van toetreding, uittreding of uitsluiting van leden-deelgenoten zal het aantal bestuurders- afgevaardigden van elke bestuurder-deelgenoot in de raad van bestuur worden vastgesteld via een statutenwijziging. Het aantal bestuurders-afgevaardigden wordt bepaald in verhouding tot ieders inbreng in de vereniging.\n\n83 De algemene vergadering kan, op voordracht van de raad van bestuur, maximum twee (2) onafhankelijke bestuurders benoemen conform artikel 484, 82 decreet lokaal bestuur. In het kader van een objectieve selectie van kandidaten wordt een onafhankelijk selectiekantoor aangesteld. De aanstelling van het selectiekantoor wordt beslist door de raad van bestuur. De specifieke procedure betreffende de kandidatuurstelling en de selectie, alsook de voorwaarden voor de benoeming van onafhankelijke bestuurders, worden voort uitgewerkt in het huishoudelijk reglement. \u002F\n\nBehoudens de verbodsbepalingen en onverenigbaarheden zoals bepaald via de artikelen 10 en 27 decreet lokaal bestuur en die gelden voor iedere bestuurder-afgevaardigde, mogen de onafhankelijke bestuurders: — geen lid zijn van de bestuurs- en beheersorganen van de deelgenoten;\n\n- geen lid zijn van de bestuurs- en beheersorganen van een ziekenhuis van het ziekenhuisnetwerk waartoe AZ. Jan Palfijn Gent behoort;\n\n— _niet professioneel werkzaam zijn in het ziekenhuis of in een ziekenhuis van het ziekenhuisnetwerk waartoe A.Z. Jan Palfijn Gent behoort, ongeacht hun juridisch statuut;\n\n— gedurende een onafgebroken periode van twee (2) jaar voorafgaand aan de benoeming niet professioneel werkzaam geweest zijn in het ziekenhuis of in een ziekenhuis van het ziekenhuisnetwerk waartoe A.Z. Jan Palfijn Gent behoort, ongeacht hun juridisch statuut;\n\n— geen lid zijn van de bestuurs- en beheersorganen en geen personeelslid zijn van een rechtspersoon of Organisatie waardoor belangenvermenging ontstaat.\n\nDe onafhankelijke bestuurders oefenen een mandaat uit gedurende een periode van zes (6) Jaar, onbeperkt hernieuwbaar.\n\nDe onafhankelijke bestuurders kunnen op elk moment ontslag nemen. Het ontslag gebeurt met een per post aangetekende brief en wordt overgemaakt aan de voorzitter van de raad van bestuur.\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\nYoor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\nMod DOC 19.01 - AL.\n\nEen onafhankelijk bestuurder die ontslag neemt moet geen opzegtermijn in acht nemen. in geval van ernstige redenen kunnen de onafhankelijke bestuurders altijd worden ontslagen door de algemene vergadering, op voordracht van de raad van bestuur.\n\n84. De volgende personen, bestuurders-experten genoemd, worden uitgenodigd om de vergadering van de raad van bestuur met raadgevende stem bij te wonen:\n\n— de bestuurder-directeur;\n\n— de hoofdarts van het ziekenhuis;\n\n— de ziekenhuisarts van het ziekenhuis benoemd door de algemene vergadering conform artikel 484, $3 juncto artikel 500 decreet lokaal bestuur, op voordracht van de raad van bestuur, gekozen uit een lijst van minstens drie (3) kandidaten, opgesteld door de medische raad. Er wordt telkens een bestuurder- expert en een plaatsvervanger benoemd door de algemene vergadering respectievelijk voorgedragen door de raad van bestuur. De medische raad kan in een tijdelijke vervanging van zijn bestuurder-expert voorzien, door dit schriftelijk mee te delen aan de voorzitter en dit ten laatste 72 uur voor het aanvangsuur dat vermeld is op de uitnodiging van de vergadering;\n\n— een afgevaardigde, benoemd door de algemene vergadering conform artikel 484, S3 juncto artikel 500 decreet lokaal bestuur, op voordracht van de raad van bestuur, gekozen uit één of meer kandidaten, voorgesteld door deelgenoot OCMW Gent. Deze afgevaardigde is geen lid van de gemeenteraad Gent en\u002Fof van de raad voor maatschappelijk welzijn Gent, noch een personeelstid van stad Gent en\u002Fof OCMW Gent, mag niet professioneel werkzaam zijn in de vereniging, noch als personeelslid noch als zelfstandige, en mag geen enkele onverenigbaarheid hebben met de hoedanigheid van bestuurder- expert;\n\n— een afgevaardigde, benoemd door de algemene vergadering conform artikel 484, $3 juncto artikel 500 decreef lokaal bestuur, op voordracht van de raad van bestuur, gekozen uit één of meer kandidaten, voorgesteld door deelgenoof Institut Moderne vzw. Deze afgevaardigde mag geen bestuurder zijn van Institut Moderne vzw, noch een personeelslid van Institut Moderne vzw, mag niet professioneel werkzaam zijn in de vereniging, noch als personeelslid noch als zelfstandige, en mag geen enkele onverenigbaarheid hebben met de hoedanigheid van bestuurder-expert. Het voorgaande is niet van toepassing wanneer de besprekingen handelen over aangelegenheden waarbij de bestuurder-expert persoonlijk en rechtstreeks betrokken is.\n\n85. De volgende personen kunnen ad hoc en dus in functie van de agendapunten als bestuurders-experten ad hoc de vergadering van de raad van bestuur of een deel ervan bijwonen in het kader van hun expertise: - een directielid van het ziekenhuis, om een dossier toe te lichten en\u002Fof te bespreken;\n\n— _ personen met bijzondere deskundigheid, waarvan de aanwezigheid door de raad van bestuur als nuttig of noodzakelijk wordt geacht; .\n\n- de voorzitter of een andere afgevaardigde van de medische raad van het ziekenhuis. Artikel 27. Functies - verwijzing\n\nHet voorzitterschap en het secretariaat van de raad van bestuur worden waargenomen volgens dezelfde regels als die van de algemene vergadering, bepaald in artikel 15.\n\nArtikel 28. Aansprakeliikheid\n\nDe bestuurders-deelgenoten, de bestuurders-afgevaardigden en de onafhankelijke bestuurders kunnen niet persoonlijk aansprakelijk gesteld worden voor de verplichtingen en de verbintenissen aangegaan door de vereniging. Tussen hen bestaat geen hoofdelijkheid.\n\nArtikel 29. Bevoegdheid\n\nDe raad van bestuur is belast met het bestuur van de vereniging en is bevoegd orn alle zaken te behandelen en beslissingen te nemen die door de onderhavige statuten niet voorbehouden werden aan de algemene vergadering.\n\nDe raad van bestuur is onder meer bevoegd voor:\n\n— _ opstellen (of wijzigen) van de missie-visie-waarden en strategische doelstellingen van het ziekenhuis;\n\n— opstellen en bewaken van een zorgstrategisch plan;\n\n— de opvolging van de implementatie van de operationele doelstellingen en jaaractieplannen van het ziekenhuis en de daaruit voortvloeiende beleidsnota's;\n\n— de opvolging van de plannen over de structurele samenwerking met andere ziekenhuizen of andere zorgactoren;\n\n~ de aanstelling van de bestuurder-directeur en directieleden;\n\n— de beëindiging van de samenwerking met de bestuurder-directeur of een directielid na gemotiveerde evaluatie;\n\n— de aanstelling van ziekenhuisartsen, medische diensthoofden en medische afdelingshoofden, rekening\n\nhoudend met het advies van de medische raad;\n\n— de beëindiging van de samenwerking met ziekenhuisartsen, alsook de beëindiging tot aanstelling als ziekenhuisarts, of als medisch diensthoofd of als afdelingshoofd, rekening houdend met het advies van de medische raad:\n\n- de aanduiding van de leden van de delegatie voor het permanent overlegcomité (POC) conform artikel 142, $2 van de gecoördineerde ziekenhuiswet. Deze leden worden aangeduid onder de stemgerechtigde leden van de raad van bestuur;\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\nVoor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\n‘\n\n;\n\nt\n\n' t\n\n; '\n\n; i\n\nt ‘\n\n' i\n\n'\n\n'\n\nt '\n\n‘\n\n1 '\n\n1 '\n\n1 t\n\n1 '\n\nMod DOC 19.01 - AL\n\n- de financiële afspraken met ziekenhuisartsen, alsook voor de bepaling van toegelaten supplementen;\n\n—  delegatieregels inzake beslissings — en handtekeningsbevoegdheden op te stellen op voorstel van de bestuurder-directeur;\n\n— beslissingen over de gunningswijze en het gunnen van werken, leveringen en diensten, met inbegrip van beslissingen over de financieringsmodaliteiten ervan vanaf 250.000 euro, voor zover het geen gunningen betreft die een rechtstreekse weerslag hebben op de honorarium gebonden diensten;\n\n— de bepaling van de kostprijs en de transfertprijs van aan derden aan te rekenen leveringen en diensten, op voorstel van de bestuurder-directeur;\n\n— de periodieke opvolging van de activiteitencijfers, financiële cijfers, ken — en stuurgetallen, exploitatiecijfers en van het beleid, de initiatieven en indicatoren inzake kwaliteit en patiëntveiligheid; —  bespreking en goedkeuring voorstel van begroting;\n\n— de bepaling van het remuneratiebeleid voor de bestuurder-directeur en directieleden op advies van het remuneratiecomité.\n\nDe raad van bestuur stelt tevens de leden van het auditcomité en remuneratiecomité aan. Het auditcomité is belast met de vaststelling van een prioriteitenlijst voor de uit te voeren financiële en operationele audits, de bespreking van de auditbevindingen en formuleren van voorstellen aan de raad van bestuur en het controleren en opvolgen van de eigenlijke auditactiviteiten. De samenstelling van het auditcomité en de specifieke taken van het auditcomité worden bepaald in het huishoudelijk regelement.\n\nHet remuneratiecomité is belast met het verloningsbeleid in het ziekenhuis van de directie en het kaderpersoneel en bewaakt de. marktconformiteit en de interne consistentie van het remuneratiebeleid. De samenstelling en de specifieke taken van het remuneratiebeleid worden bepaald in het huishoudelijk reglement. De raad van bestuur kan bijzondere werkgroepen of commissies oprichten voor de studie en voorstellen van oplossingen van bepaalde problemen die verband houden met de doelstellingen van de vereniging. De raad kan deze opdrachten intrekken.\n\nAls de raad van bestuur beslist om geen “bestuurder-directeur” aan te stellen, moet in deze statuten de term ‘bestuurder-directeur” gelezen worden als “algemeen directeur\" waarmee wordt verwezen naar de functie “directeur” uit artikel 17 van de gecoördineerde ziekenhuiswet en de daaraan gekoppelde bevoegdheden en verantwoordelijkheden.\n\nArtikel 30. Samenkomst, wijze van bijeenroeping en agenda\n\nDe raad van bestuur vergadert maandelijks op de dagen en uren vastgesteld door het huishoudelijk reglement. Bovendien roept de voorzitter de raad van bestuur samen telkens hij dit noodzakelijk acht. Hij is er voort toe gehouden de raad bijeen te roepen op aanvraag van minstens een derde (1\u002F3) van de bestuurders-afgevaardigden en de onafhankelijke bestuurders, met de agendapunten door hen bepaald en eventueel door hem aangevuld. De vergadering moet plaatshebben binnen de vijftien (15) dagen na de aanvraag. De uitnodigingen voor de raad van bestuur met agenda worden elektronisch en\u002Fof per post verstuurd in opdracht van de voorzitter of bij zijn verhindering de tweede ondervoorzitter en de verslaggever van de raad van bestuur. De uitnodiging met agenda wordt bezorgd op het elektronisch adres of verblijfsadres zoals opgegeven door elke bestuurder-afgevaardigde en onafhankelijke bestuurder. De agenda wordt op hetzelfde moment op elektronische wijze of per post aan de voorzitter van het OCMW bezorgd. De uitnodiging met agenda wordt tenminste zeven (7) kalenderdagen voor de dag van de vergadering bezorgd. Deze fermijn kan worden ingekort in spoedeisende gevallen tot twee (2) kalenderdagen. Het spoedeisend karakter moet op gemotiveerde wijze worden uiteengezet in de uitnodiging en door de raad van bestuur worden erkend in een afzonderlijk agendapunt.\n\nDe agenda wordt opgesteld door de voorzitter van de raad van bestuur doch moet worden aangevuld met de punten, waarvan één of meer bestuurders-afgevaardigden of onafhankelijke bestuurders bij verzoek aan de voorzitter van de raad van bestuur gericht, ten minste drie (3) kalenderdagen voor de vergadering, de behandeling vragen.\n\nDe documenten over de agendapunten, inclusief de definitieve versie van de notulen, worden meegestuurd met de uitnodiging of liggen minstens - behoudens in spoedeisende gevallen - zeven (7) kalenderdagen vooraf ter inzage op de zetel van de vereniging.\n\nDe ontwerpen van documenten over de begroting en de jaarrekening worden in elk geval samen met de uitnodiging en agenda verstuurd.\n\nDe vergaderingen van de raad van bestuur hebben plaats in de zetel van de vereniging, tenzij de voorzitter van de raad van bestuur anders beslist.\n\nArtikel 31. Wijze van vergaderen\n\nDe bijeenkomsten van de raad van bestuur worden gehouden achter gesloten deuren. Alle personen (stemgerechtigde en niet-stemgerechtigde) die de vergadering bijwonen tekenen de aanwezigheidslijst met aanduiding van de hoedanigheid waarin zij optreden. De aanwezigheidslijst wordt ondertekend op het ogenblik van hun aankomst en deze maakt deel uit van de notulen van de vergadering. Indien een persoon slechts gedurende een gedeelte van de vergadering aanwezig is, wordt in de notulen melding gemaakt van het ogenblik waarop hij de vergadering bijwoont of verlaat. De aanwezigheidslijst geldt tot bewijs van het tegendeel.\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\nVoor-\n\nbehouden\n\n“aan het\n\nBelgisch\n\nStaatsblad\n\n1 ı\n\nt\n\n\\\n\n\\\n\n; è\n\nMod DOG 19.01 - AL\n\nArtikel 32. Aanwezigheidsquorum en vereiste meerderheden\n\n. De raad van bestuur kan slechts geldig beraadslagen als de meerderheid van de bestuurders-afgevaardigden en de onafhankelijke bestuurders aanwezig of vertegenwoordigd is.\n\nindien het voormelde minimum niet bereikt is, wordt binnen de maand een nieuwe raad van bestuur samengeroepen, die geldig kan beslissen over de punten die voor de tweede maal op de agenda worden geplaatst, ongeacht het aantal aanwezige of vertegenwoordigde bestuurders-afgevaardigden en onafhankelijke bestuurders.\n\nEen bestuurder-afgevaardigde kan bij verhindering schriftelijk volmacht geven aan een andere bestuurder- afgevaardigde van dezelfde bestuurder-deelgenoot. Elke bestuurder-afgevaardigde kan maximaal één (1) volmacht dragen. Indien geen enkele bestuurder-afgevaardigde aanwezig kan zijn, kan geen volmacht worden gegeven aan de bestuurders-afgevaardigden van de andere bestuurders-deelgenoten. De betrokken bestuurder- deelgenoot is ín zulk geval niet vertegenwoordigd en dus afwezig op de vergadering. Een onafhankelijke bestuurder kan bij verhindering schriftelijk volmacht geven aan een andere onafhankelijke bestuurder. Elke onafhankelijke bestuurder kan maximaal één (1) volmacht dragen. Elke bestuurder-afgevaardigde en elke onafhankelijke bestuurder heeft één stem. De beslissingen worden genomen bij volstrekte meerderheid van stemmen, overeenkomstig artikel 3, $2 van deze statuten,\n\ningeval van staking van stemmen, is de stem van de bestuurder-afgevaardigde die de vergadering voorzit doorslaggevend. .\n\nDe stemming is geheim wanneer het gaat om de aanduidingen van personen, conform het decreet lokaal bestuur. Voor iedere aanduiding wordt tot een afzonderlijke stemming overgegaan. Artikel 33. Onverenigbaarheden\n\nHet bepaalde in artikel 27 decreet lokaal bestuur is van toepassing op de raad van bestuur. Artikel 34. Notulen en afschriften\n\nDe beslissingen van de raad van bestuur worden genotuleerd door de verslaggever. De notulen worden na goedkeuring door de raad van bestuur, ondertekend door de voorzitter van de raad van bestuur en de verslaggever. De notulen worden beheerd door de verslaggever. Afschriften van of uittreksels uit de notulen worden ondertekend door de voorzitter van de raad van bestuur of bij zijn verhindering door de eerste of de tweede ondervoorzitter en door de verslaggever. De notulen liggen op de zetel van de vereniging ter inzage van de bestuurders-afgevaardigden en de onafhankelijke bestuurders. Deze documeriten kunner ook elektronisch ter beschikking worden gesteld, indien een bestuurder-afgevaardigde of een onafhankelijke bestuurder daartoe de wens uitdrukt. De bestuurders- afgevaardigden, de onafhankelijke bestuurders, de bestuurders-experten en de bestuurders-experten ad hoc zijn = onder verwijzing naar het artikel 458 van het strafwetboek - tot geheimhouding verplicht over deze informatie en over alle aangelegenheden behandeld door de organen van de vereniging. Een afschrift van de notulen en van alle documenten waarnaar deze notulen verwijzen, wordt indien een lid van de raad voor maatschappelijk welzijn dat wenst elektronisch aan hem ter beschikking gesteld, Het secretariaat van de vereniging zorgt voor de door de wet voorgeschreven publicaties in het Belgisch Staatsblad.\n\nArtikel 35. Financieel beheer en jaardocurnenten\n\nHet financieel beheer wordt gevoerd volgens de gecoördineerde ziekenhuiswet. De raad van bestuur stelt haar financieel jaarverslag, de balans, de resultatenrekening, de bedrijfsrekeningen, alsmede een ontwerpbegroting van de vereniging voor het komende boekjaar op in voorbereiding van de algemene vergaderingen in de zin van artikel 16, eerste lid.\n\nArtikel 36, Dagelijks bestuur\n\nHet dagelijkse bestuur, alsook de voorbereidende werkzaamheden gekoppeld aan te nemen beslissingen op niveau van de raad van bestuur en de uitvoering van genomen beslissingen, behoort toe aan de bestuurder- directeur en aan het directiecomité, organen waarvan de bevoegdheden in deze statuten nader worden bepaald. De bestuurder-directeur is de directeur in de zin van de gecoördineerde ziekenhuiswet. De bestuurder- directeur legt rechtstreeks en uitsluitend verantwoording af ten aanzien van de ràad van bestuur. Hij\u002Fzij werkt nauw samen met de leden van het directiecomité, die allen rapporteren aan de bestuurder-directeur. De bestuurder-directeur draagt de eindverantwoordelijkheid over het organisatorisch beleid van alle departementen van het ziekenhuis. 7\n\nDe bestuurder-directeur is bevoegd voor:\n\n— het dagelijks beheer van het ziekenhuis en de uitvoering van de beslissingen van de raad van bestuur;\n\n— de opvolging, bewaking en bijsturing waar nodig van de operationele werking in de verschillende departementen van het ziekenhuis;\n\n- de periodieke opvolging van de activiteiten en financiële cijfers;\n\n— _de optimalisatie van de zorg — en ondersteunende processen in termen van efficiëntie en effectiviteit in nauwe samenwerking en dialoog met de bevoegde directieleden en\u002Fof medische stafleden;\n\n— de opvolging, bewaking en bijsturing van het beleid, initiatieven en {indicatoren inzake kwaliteit en patiëntveiligheid;\n\n— _de opvolging, bewaking en bijsturing van het HR beleid van het ziekenhuis rekening houdend met het personeelsstatuut van het ziekenhuis;\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\nVoor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\nMod DOC 19.01 - AL.\n\n- de aanwerving en het ontslag van het personeel;\n\n— de sanctie- en tuchtbevoegdheid ten aanzien van het personeel;\n\n— de aanwerving en het ontslag van zelfstandige paramedici die verbonden zijn door een aannemingsovereenkomst met het ziekenhuis;\n\n— de vaststelling en de wijziging van de uurroosters van het personeel;\n\n— alle beslissingen in verband met de uitvoering van overheidsprogramma's ter bevordering van de werkgelegenheid;\n\n- de beslissingen over de gunningswijze en het gunnen van werken, leveringen en diensten, met inbegrip van de beslissingen inzake de financieringsmodaliteiten ervan, tot een maximum bedrag van tweehornderdvijftigduizend euro (€ 250.000, 00);\n\n— alle beslissingen over de gunningswijze en de gunning van werken, leveringen en diensten binnen en in uitvoering van de medische investeringsbegroting voor zover ze betrekking hebben op de honoraria gebonden diensten en ten laste van de medische honoraria worden betaald en dit op eensluidend advies van de Medische Raad; .\n\n— de creatie van overlegorganen met een afvaardiging van de Medische Raad teneinde de geintegreerde besluitvorming binnen het ziekenhuis te bevorderen.\n\nHet directiecomité is samengesteld uit zeven (7) leden, namelijk\n\n-de bestuurder-directeur, die het directiecomité voorzit;\n\n- de hoofdarts;\n\n-de verpleegkundig en paramedisch directeur;\n\n-de financieel-administratief directeur;\n\n-de HR-directeur;\n\n-de ICT & facilitalr directeur;\n\n-de directeur procesoptimalisatie en datamanagement.\n\nHet directiecomité heeft beleidsvoorbereidende, codrdinerende en uitvoerende taken. De beslissingen van het dagelijks bestuur worden genotuleerd. Een afschrift van de notulen en van alle documenten waarnaar deze notulen verwijzen, wordt indien een lid van de raad voor maatschappelijk welzijn dat wenst elektronisch aan hem ter beschikking gesteld.\n\nArtikel 37. De hoofdarts\n\nDe hoofdarts is verantwoordelijk voor de goede gang van zaken in het medisch departement. Hij\u002Fzij dient de functie uit te oefenen rekening houdend met respect voor autonomie, het beroepsgeheim en de (eind)verantwoordelijkheden van de hoofdarts cfr. de artikelen 18 tem 22 van de gecoördineerde ziekenhuiswet en de bepalingen van KB, dd. 15.12.1987. Hij\u002Fzij is verantwoordelijk voor de voorbereiding en uitvoering van de beheersbeslissingen inzake de organisatie en coördinatie van de medische activiteiten onder meer door zijn visie ter zake toe te lichten hetzij bij de raad van bestuur, hetzij aan de bestuurder-directeur die hiertoe, voor zover nodig, bij deze gemandateerd wordt door de raad van bestuur. Hij\u002Fzij legt daartoe tevens verantwoording af hetzij aan de raad van bestuur, hetzij aan de bestuurder-directeur die hiertoe bij deze gemandateerd wordt door de raad van bestuur.\n\nTITEL 6: VOORZITTERSCHAP RAAD VAN BESTUUR EN BESTUURDER-DIRECTEUR Artikel 38. Aanstelling van de voorzitter en de ondervoorzitters,\n\nDe voorzitter van de raad van bestuur en de tweede ondervoorzitter worden aangesteld door de raad van bestuur uit de bestuurders-afgevaardigden van de bestuurder-deelgenoot “het OCMW”. De eerste ondervoorzitter wordt aangesteld door de raad van besfuur uit de bestuurders-afgevaardigden van de bestuurder-deelgenoot “Institut Moderne vzw”.\n\nDe tweede ondervoorzitter zal het voorzitterschap binnen het kader van toegewezen bevoegdheden - zoals bepaald in het huishoudelijk reglement - waarnemen tijdens de afwezigheid van de voorzitter. Artikel 39. Voorzitter - bevoegdheid\n\nDe voorzitter van de raad van bestuur leidt de zaken van de vereniging. De voorzitter wordt geacht zijn functie uit te oefenen conform de profielbeschrijving zoals opgenomen in het huishoudelijk reglement. Hij en bij zijn verhindering de tweede ondervoorzitter, beschikken samen met de bestuurder-directeur over de maatschappelijke handtekening in alle aangelegenheden, zonder van enige machtiging te moeten doen blijken, De raad van bestuur kan echter, met inachtneming van de bevoegdheidsregeling, zoals bepaald in deze statuten, handtekeningrechten delegeren aan de bestuurder-directeur, die hij\u002Fzij onder zijn\u002Fhaar verantwoordelijkheid kan subdelegeren aan één of meer leden van het directiecomité. Artikel 40, Rol van elke bestuurder\n\nElk lid van de raad van bestuur (stemgerechtigde en niet-stemgerechtigde)} wordt geacht zijn functie uit te oefenen zoals beschreven in het huishoudelijk reglement. Daarbij is elke hij\u002Fzij ertoe gehouden bij de aanvang van het mandaat de ethische en governancecode van het ziekenhuis te ondertekenen ter kennisname en er tevens naar te handelen.\n\nDe ethische en governancecode van het ziekenhuis is toegevoegd aan het huishoudelijk reglement van het ziekenhuis en wordt aan elk lid van de raad van bestuur persoonlijk overhandigd.\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge\f\n\n„ behouden\n\nyoor-\n\naan het\n\nBelgisch\n\nStaatsblad\n\nMod DOC 19.01 « AL\n\nArtikel 41. Bestuurder-directeur van het ziekenhuis en verslaggever\n\nDe bestuurder-directeur is ook belast met de uitvoering van de beslissingen van de organen van de vereniging. De verslaggever is belast met het secretariaat.\n\nZij handelen overeenkomstig de bepalingen van de gecoördineerde ziekenhuiswet. TITEL 7: FINANCIËLE EN BOEKHOUDKUNDIGE REGELS\n\nArtikel 42. Boekjaar\n\nHet maatschappelijk boekjaar begint op één (1) januari en eindigt op éénendertig (31) december van hetzelfde jaar.\n\nleder jaar, per éénendertig (31) december, worden de rekeningen van het afgelopen boekjaar afgesloten. De begroting van het volgende boekjaar dient te worden goedgekeurd ten laatste ín december van het jaar voorafgaand aan het begrotingsjaar.\n\nDe jaarrekening dient te worden goedgekeurd vóór dertig (30) juni van het daaropvolgende jaar. Artikel 43. Boekhouding\n\nDe boekhouding wordt gehouden conform de toepasselijke wetgeving.\n\nArtikel 44. Resultaat van het boekjaar\n\nHet eventueel batig saldo bij afsluiten van de jaarrekening wordt geboekt op het reservefonds van de vereniging.\n\nEventuele tekorten worden gedragen conform artikel 125 van de gecoördineerde ziekenhuiswet. Artikel 45. Bijkomende inbrengen en verbintenissen van de leden-deelgenoten Voor elke ten aanzien van huidige statuten bijkomende, rechtstreekse of onrechtstreekse, financiële inbreng of verbintenis van één of meer leden-deelgenoten, is steeds het uitdrukkelijk en voorafgaand akkoord van de betrokken leden-deelgenoten vereist.\n\nTITEL 8: ONTBINDING\n\nArtikel 46. Verwijzing\n\nDe vroegtijdige ontbinding van de vereniging geschiedt, het goedkeuringstoezicht onverlet gelaten, mits voorafgaande instemming van de leden-deelgenoten, conform artikel 482 decreet lokaal bestuur en de artikelen 19 en 20 van de huidige statuten.\n\nBij de ontbinding van de vereniging wordt het voltallige personeel overgenomen, hetzij door de deelnemers, hefzij eventueel door de overnemers van-de activiteit, in verhouding tot de inbreng of overeenkomstig de onderling bereikte akkoorden, en zonder dat dà Bérsoripélsfeden door deze plicht tot overname gebonden zijn. De statutaire personeelsleden worden, al dan ri tin-verhouding | tôt de inbreng, door de publieke rechtspersonen overgenomen. De nieuwe werkgever waafhörgt de Yethten die de vereniging op het ogenblik van haar ontbinding, hetzij statutair, hetzij contractueel vopr.de werkhemers yastgasyeld had. Het overgenomen personeel komt, met behoud van zijn geldelijk statuut, terectibin een lovengan Kader at uitdovend is.\n\nArtikel 47. Bestemminc Man;\n\nIn toepassing van artikel 49 Hokaal. ele en van de natrekkingen ingevolge beëindiging van erfpachten onverkort gelaten, ko de: netto-opbrengst van de vereffening toe aan de leden-deelgenoten in verhouding tot de boekwaarde op dat ogenblik vart hun inbreng.”\n\n- VOOR ANALYTISCH UITTREKSEL\n\nNotaris Jeroen Parmentier\n\nSamen hiermee neergelegd:\n\n-expeditie van het proces-verbaal\n\nOp de laatste biz. van Luik B vermelden : Voorkant: Naam en hoedanigheid van de instrumenterende notaris, hetzij van de perso(o)n(en)\n\nbevoegd de rechtspersoon ten aanzien van derden te vertegenwoordigen\n\nAchterkant : Naam en handtekening (dit geldt niet vaor akten van het type “Mededelingen”.\n\nBijlagen bij het Belgisch Staatsblad - 17\u002F09\u002F2019 - Annexes du Moniteur belge","2019-09-17\u002F0124267","https:\u002F\u002Fwww.ejustice.just.fgov.be\u002Ftsv_pdf\u002F2019\u002F09\u002F17\u002F19124267.pdf","MAATSCHAPPELIJKE ZETEL - STATUTEN (VERTALING, COÖRDINATIE, OVERIGE WIJZIGINGEN, …)","BE_TU9OSVRPUiMvdHN2X3BkZi8yMDE5LzA5LzE3LzE5MTI0MjY3LnBkZg",{"categories":223,"date":225,"date_format":48,"source":207,"content":226,"id":227,"link":228,"label":229,"file_token":230},[224,215],"Benaming","2013-01-29"," In de bijlagen bij het Belgisch Staatsblad bekend te maken kopie na neerlegging ter griffie van de akte Voor- behouder aan het Belgisch Staatsblac 3 MONITEUR BELGE INN 2 ar 13 82* 0168 BELGISCH STAATSBLAD \"Griffte — | Benaming: A.Z. JAN PALFIN GENT, AV. Rechtsvorm : Vereniging van openbare centra voor maatschappelijk welzijn Zetel: Henri Dunantlaan 5 9000 Gent Ondernemingsnr: BE0262.926.616 Voorwerp akte : Statutenwijziging - Coördinatie van statuten | Uit het proces-verbaal verleden op 18 december 2012 voor notaris Jeroen PARMENTIER, geassocieerd notaris: in de burgerlijke vennootschap met de rechtsvorm van een coöperatieve vennootschap met beperkte: aansprakelijkheid “DE GROO, BLINDEMAN, VAN BELLE, PARMENTIER & VAN OOST, GEASSOCIEERDE; NOTARISSEN”, met zetel te 9000 Gent, Kouter 27, te registreren, blijkt dat de buitengewone algemene vergadering van de deelgenoten van de vereniging met rechtspersoonlijkheid “ALGEMEEN ZIEKENHUIS JAN PALFIJN GENT, autonome verzorgingsinstelling”, in het kort “A.Z. JAN PALFIJN GENT, AV”, met t maatschappelijke zetel te 9000 Gent, Henri Dunantlaan 5, ondernemingsnummer BE0262.926.616, RPR Gent,’ s bijeengekomen en volgende te publiceren beslissingen met eenparigheid van stemmen heeft genornen: WIJZIGING VAN ARTIKEL 3 VAN DE STATUTEN e vergadering beslist artikel 3 van de statuten integraal te schrappen en te vervangen door volgende tekst: De Vereniging werd opgericht als een Openbaar Bestuur overeenkomstig de bepalingen van Hoofdstuk XII van: ‚de Organieke Wet op de Openbare Centra voor Maatschappelijk Welzijn van acht juli negentienhonderd: zesenzeventig, en haar werking wordt thans beheerst door Titel Vill, Hoofdstuk | van het decreet van 19° \" december 2008 betreffende de organisatie van de openbare centra voor maatschappelijk welzijn of kortweg, “OCMW-decreet”. WIJZIGING VAN ARTIKEL 5 VAN DE STATUTEN De vergadering beslist het eerste lid van artikel 5 integraal te schrappen en te vervangen door volgende tekst: : “De Vereniging werd opgericht voor een termijn van dertig (30) opeenvolgende jaren, ingaande op één januari: : negentienhonderd achtennegentig. Ze wordt vervroegd verlengd voor een termin van dertig (30): . opeenvolgende jaren ingaande op één januari fweeduizend en twaalf en eindigend op eenendertig december tweeduizend eenenveertig.” WIJZIGING VAN ARTIKEL 6 VAN DE STATUTEN ' De vergadering beslist de volgende tekst in fine van het tweede lid van artikel 6: “...de toepassing artikel 125,: eerste lid van de Organieke Wet op de Openbare Centra voor Maatschappelijk Welzijn onverlet gelaten”, te schrappen en te vervangen door volgende tekst: “... verstaan zijnde dat de openbare rechtspersonen steeds dienen te beschikken over de meerderheid van de stemmen in de Algemene Vergadering, in de Raad van Bestuur en in het Managementcomité”. WIJZIGING VAN ARTIKEL 7 VAN DE STATUTEN _ De vergadering beslist de volgende tekst in fine van het tweede lid van artikel 7: “... zoals bepaald in artikel. ‘ 123 van de Organieke Wet op de Centra voor Maatschappelijk Welzijn”, te schrappen en te vervangen door, volgende tekst: : “..zoels bepaald in artikel 225 van het OCMW-decreet.” WIJZIGING VAN ARTIKEL 10 VAN DE STATUTEN De vergadering beslist de tweede paragraaf van artikel 10 integraal te schrappen en te vervangen door volgende tekst: “82, Onderhavige regeling geldt zonder afbreuk te doen aan artikel 225 van het OCMW decreet.” WIJZIGING VAN ARTIKEL 12 VAN DE STATUTEN : De vergadering beslist de volgende tekst van het zesde lid van artikel 12: “Bovendien wonen de bestuurders, : die geen lid zijn van de Algemene Vergadering, in voorkomend geval, de deskundigen, de leden (...) en een’ ; vertegenwoordiger van het College van Burgemeester en Schepenen van de stad Gent, de Algemene : Vergadering bij, zij het zonder stemrecht”, te schrappen en te vervangen door volgende tekst: : “Bovendien wonen de bestuurders, die geen lid zijn van de Algemene Vergadering, de leden (...) en de burgemeester van de stad Gent of de schepen die hem vervangt (met de bevoegdheid zoals bepaald in artikel 42 van het OCMW-decreet) de Algemene Vergadering bij, zij het zonder stemrecht.” ‘ WIJZIGING VAN ARTIKEL 13 VAN DE STATUTEN „De vergadering beslist het laatste lid van paragraaf 2 van artikel 13 integraal te schrappen. Op de laatste blz. van Luik B vermelden : Recto : Naam en hoedanigheid van de instrumenterende notaris, hetzij van de perso{o)n(en) bevoegd de rechtspersoon ten aanzien van derden te vertegenwoordigen Verso : Naam en handtekening Bijlagen bij het Belgisch Staatsblad - 29\u002F01\u002F2013 - Annexes du Moniteur belge\f + Voor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\nLuik B - Vervolg\n\ni “De vergadering beslist volgende tekst van het laatste zinsdeel van paragraaf 3 van artikel 13: “onverminderd | : de toepassing van artikel 119 van de Organieke Wet op de Openbare Centra voor Maatschappelijk Welzijn’, te: : schrappen en te vervangen door volgende tekst:\n\n: “onverminderd de toepassing van de artikelen 220 en 224 van het O.C.M.W.-decreet.” : : WIJZIGING VAN ARTIKEL 23 VAN DE STATUTEN\n\n‘ “De vergadering beslist om artikel 23 integraal te schrappen en te vervangen door volgende tekst: “Het bepaalde in artikel 37 van het OCMW-decreet is van overeenkomstige toepassing op de sterngerechtigde | ‘ leden van de Algemene Vergadering en, in voorkomend geval, op de burgemeester of de schepen die hem, t vervangt.”\n\n: WIJZIGING VAN ARTIKEL 26 VAN DE STATUTEN\n\n‘De vergadering beslist artikel 26 integraal te schrappen en te vervangen door volgende tekst: i “Alle leden van de Algemene Vergadering hebben het recht om ter plaatse, op de zetel van de Vereniging, : ; kennis te nemen van de notulen van de Algemene Vergadering, van de Raad van Bestuur en van het: Managementcomité en van alle documenten waamaar verwezen wordt ín deze notulen, Deze worden, indien! reen lid van de Algemene Vergadering daartoe de wens uitdrukt, hem\u002Fhaar ook elektronisch ter beschikking ! + gesteld, :\n\n: } Zij zijn, onder verwijzing naar het artikel 458 van het strafwetboek, tot geheimhouding verplicht betreffende deze, | : informatie en betreffende alle aangelegenheden behandeld door de organen van de Vereniging.” | : WIJZIGING VAN ARTIKEL 27 VAN DE STATUTEN\n\n: De vergadering beslist artikel 27 integraal te schrappen en te vervangen door volgende tekst: “De Vereniging wordt beheerd door een Raad van Bestuur.\n\n! De Raad van Bestuur is samengesteld uit minimum vijftien (15) en maximum zeventien (17) stemgerechtigde : : leden, aangesteld als volgt:\n\n- elf (11) leden door de Algemene Vergadering, dit op voordracht van:\n\nı + negen (9) leden, fid van het Openbaar Genfrum voor Maatschappelijk Welzijn van Gent, door die Read, ‘ waaronder verplicht de OCMW-voorzitter,\n\n? + twee (2) leden door de Vereniging Zonder Winstoogmerk “Institut Modeme’; i ! - één (1) lid, genaamd bestuurder-directeur, gecodpteerd door de Raad van Bestuur!\n\novereenkomstig een objectieve procedure in gemeen overleg te bepalen door de deelgenoten, bij, wege van hun vertegenwoordigers in de Raad van Bestuur,\n\n- drie (3) leden, onafhankelijke bestuurders, bij tweede coöptatie, waarvan twee (2) leden op voordracht van het Openbaar Centrum voor Maatschappelijk Welzijn van Gent en één (1) lid op, voordracht van de Vereniging Zonder Winstoogmerk \"Institut Modeme”; behoudens het geval van: vervanging in de loop van hun mandaat, worden de drie (3) onafhankelijke bestuurders door de Raad van Bestuur aangesteld in één enkele sternming;\n\n- twee (2) leden, ziekenhuisgeneesheren, aangesteld door de Raad van Bestuur, op | voordracht van de Vergadering van de ziekenhuisgeneesheren, voor zover deze Vergadering tot zulke : : voordracht(en) heeft beslist.\n\n‘ Behoudens de verbodsbepalingen van de artikelen 8 en 20 van het OCMW-decreet en de onverenigbaarheden, “zoals deze zijn bepaald in artikel 37 van het OCMW-decreet, die alle ter zake van overeenkomstige toepassing zijn en gelden voor iedere bestuurder, mogen de onafhankelijke bestuurders geen lid zijn van de bestuurs- en beheersorganen van de deelgenoten, noch personeel zijn van de deelgenoten, noch lid zijn van de bestuurs- en „beheersorganen van een ander erkend algemeen ziekenhuis in de Gentse regio. : De leden van het Directiecomité en de burgemeester van de stad Gent, of een schepen die hem vervangt, ‘kunnen de vergaderingen van de Raad van Bestuur, evenwel zonder stemrecht, bijwonen, :De voordracht van de leden, raadslid van het Openbaar Centrum voor Maatschappelijk Welzijn van Gent, : : geschiedt door deze Raad bij geheime stemming en in één enkele stemronde. Artikel 27, §3 van de Organieke . : Wet op de Openbare Centra voor Openbaar Welzijn en artikel 60 van het OCMW-decreet zijn van toepassing. . “Het huishoudelijk reglement kan toelaten dat een afgevaardigde van de Medische Raad van het + eenheidsziekenhuis de vergaderingen, of gedeeltes ervan, zonder stemrecht, bijwoont.” : WIJZIGING VAN ARTIKEL 29 BIS VAN DE STATUTEN :\n\n; De vergadering beslist de woorden “en einde opdracht deskundigen” te schrappen uit de titel van artikel 29: bis. :\n\nDe vergadering beslist eveneens de derde alinea van artikel 29 bis integraal te schrappen. WIJZIGING VAN ARTIKEL 32 VAN DE STATUTEN\n\nDe vergadering beslist om de volgende tekst van het derde en vierde lid van artikel 32: “Het ‚ Managementcomité komt maandelijks samen. Het bestaat uit ten hoogste zeven (7) leden, te weten vier (4) den door de Raad van Bestuur aangesteld uit haar leden voorgedragen door het Openbaar Centrum voor aatschappelijk Wetzijn te Gent, waaronder verplicht de Voorzitter en de Tweede Ondervoorzitter, één (1) lid, i door de Raad van Bestuur aangesteld uit haar leden voorgedragen door de Vereniging zonder Winstoogmerk : “Institut Moderne”, eventueel één (1) lid door de Raad van Bestuur aangesteld uit haar leden voorgedragen ı door de Vergadering van ziekenhuisgeneesheren en van rechtswege de bestuurder-directeur, die voorzit. De ' + vergaderingen van het Managementcomité worden ten adviserende titel bijgewoond door de deskundigen en t door de leden van het Directiecomité”, te schrappen en te vervangen door volgende tekst: \"Het Managementcomité komt minstens maandelijks samen. Het bestaat uit ten hoogste tien (10) leden, te ‘weten zes (6) leden door de Raad van Bestuur aangesteld uit haar leden voorgedragen door het Openbaar „Centrum voor Maatschappelijk Welzijn te Gent, waaronder verplicht de OCMW voorzitter en de twee (2) door dit t LOCMW voorgedragen onafhankelijke bestuurders, twee (2) leden door de raad van. bestuur aangesteld uit haar\n\nOp de laatste blz, van Luik B vermelden : Recto : Naam en hoedanigheid van de instrumenterende notaris, hetzij van de perso(o)n{en) bevoegd de rechtspersoon ten aanzien van derden te vertegenwoordigen\n\nVerso : Naam en handtekening\n\nBijlagen bij het Belgisch Staatsblad - 29\u002F01\u002F2013 - Annexes du Moniteur belge\f\n\n‘=\n\n‘+ Voor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad\n\nLuik B - Vervolg\n\n‘leden voorgedragen door de Vereniging zonder Winstoo “institut Modeme’*, waaronder verplicht de door | ‚deze VZW voorgedragen onafhankelijke bestuurder, één (1) lid door de raad van bestuur aangesteld uit haar ; leden voorgedragen door de Vergadering van ziekenhuisgeneesheren, voor zover deze Vergadering tot zulke : voordracht(en) heeft beslist en van rechtswege de bestuurder-directeur, die voorzit. ‘De vergaderingen van het Managementcomité worden ten adviserende titel bijgewoond door de leden van het! : Directiecomité.”\n\n: ‘ De vergadering beslist eveneens een nieuwe laatste lid aan artikel 32 toe te voegen luidend als volgt: “De bestuurder-directeur kan zich, ten adviserende titel, laten bijstaan door een Begeleidingscomité, dat hij \u002F zÿ° i voorzil, bestaande uit maximaal vier (4) leden, die hij \u002F zij vrij kiest, verstaan zijnde dat deze leden geen actieve : bestuurder noch personeelslid kunnen zijn. De werking van het begeleidingscomité wordt desgevallend : vastgelegd in een door de Raad van bestuur goed te keuren reglement. De leden van het Begeleidingscomité . ‘kunnen op vraag van de bestuurder-directeur, als technici zonder stemrecht, de zittingen van de Raad van, \\ Bestuur en van het Managementcomité, of een deel ervan, bijwonen”. :\n\n| WIJZIGING VAN ARTIKEL 36 VAN DE STATUTEN :\n\nDe vergadering beslist om de volgende tekst van het eerste lid van artikel 36: “Het financieel beheer wordt ! i gevoerd volgens de Gecoördineerde Wet op de Ziekenhuizen en volgens huidige statuten, de artikel 45 en 46 ! ; en de Afdelingen Il en Ill van Hoofdstuk VI van de Organieke Wet op de Openbare Centra voor Maatschappeli jk ; welzijn uitdrukkelijk uitgesloten zijnde”, te schrappen en te vervangen door volgende tekst: : “Het financieel beheer wordt gevoerd volgens de Gecoördineerde Wet op de Ziekenhuizen, in overeenstemming : met artikel 230 van het OCMW-decreet en volgens huidige statuten.”\n\n: WIJZIGING VAN ARTIKEL 37 VAN DE STATUTEN\n\nDe vergadering beslist om volgende tekst van het eerste en tweede lid van artikel 37: “De Voorzitter van de! t Raad van Bestuur, die tevens Voorzitter van de Vereniging is, wordt, uit haar leden, aangesteld door de Raad : i van Bestuur, op voordracht van het Openbaar Centrum voor Maatschappelijk Welzijn van Gent. i De Raad van Bestuur stelt tevens, uit haar leden, een Eerste en een Tweede Ondervoorzitter aan, : t respectievelijk op voordracht van de vereniging zonder winstoogmerk “institut Moderne” en op voordracht van! | het Openbaar Centrum voor Maatschappelijk welzijn te Gent”, te schrappen en te vervangen als volgt: i | “De Voorzitter van de Raad van Bestuur, die tevens Voorzitter van de Vereniging is en de Tweede: : Ondervoorzitter worden aangesteld door de Raad van Bestuur uit de bestuursleden voorgedragen door het, Ì Openbaar Centrum voor Maatschappelijk Welzijn van Gent.\n\n: De Eerste Ondervoorzitter wordt aangesteld door de Raad van Bestuur uit de bestuursleden voorgedragen door’ ; de vereniging zonder winstoogmerk “Institut Moderne”.\n\nı De vergadering beslist eveneens om volgende tekst van het vijfde lid van artikel 37: “Wordt bij een eerste 1 stembeurt de volstrekte meerderheid niet verkregen dan wordt gehandeld overeenkomstig artikel 33, §§ 3 en 4, | van de Organieke Wet op de Openbare Centra voor Maatschappelijk Welzijn” te schrappen en te vervangen als * volgt:\n\n‚ “Wordt bij een eerste stembeurt de volstrekte meerderheid niet verkregen dan wordt gehandeld overeenkomstig . artikel 47 van het OCMW-decreet.”\n\nWIJZIGING VAN ARTIKEL 38 VAN DE STATUTEN\n\nDe vergadering beslist om aan artikel 38 een derde lid toe te voegen, luidend als volgt: “De Raad van Bestuur kan echter, met inachtneming van de bevoegdheidsregeling, zoals bepaald in deze statuten, handtekeningrechten delegeren aan de bestuurder-directeur, die hij\u002Fzij, onder zijn\u002Fhaar verantwoordelijkheid kan subdelegeren aan één of meerdere leden van het Directiecomité.” : WIJZIGING VAN ARTIKEL 44 VAN DE STATUTEN ,\n\n‘De vergadering beslist om de volgende tekst van de eerste paragraaf van artikel 44: “Het administratief , „toezicht, het goedkeuringstoezicht onverlet gelaten, is beperkt tot de toepassing van de artikelen 111, 112 en: , 113 van de Organieke Wet’, te schrappen en te vervangen als volgt:\n\n‘ “Het administratief toezicht, het goedkeuringstoezicht onverlet gelaten, is beperkt tot het bepaalde in artikel 228, ' §1, fweede lid van het OCMW-decreet.”\n\n_WIJZIGING VAN ARTIKEL 45 VAN DE STATUTEN\n\n: De vergadering beslist om artike! 45 integraal te schrappen en te vervangen door volgende tekst: | “De voortijdige vrijwillige ontbinding van de Vereniging geschiedt, het goedkeuringstoezicht onverlet gelaten, ‘ i mits voorafgaande instemming van de deelgenoten, conform artikel 224 van het OCMW-decreet en de artikelen’ 118 en 19 van de huidige statuten.\n\ni De Vereniging is, conform artikel 232 van het OCMW-decreet, van rechtswege ontbonden bij het verstrijken van ! haar statutaire duur indien de verlenging niet vooraf beslist en goedgekeurd werd.” WIJZIGING VAN ARTIKEL 46 VAN DE STATUTEN {\n\n! De vergadering beslist artikel 46 integraal te schrappen en te vervangen door volgende tekst: “De toepassing van artikel 235 van het OCMW-decreet en van de natrekkingen ingevolge beéindiging van ‘erfpachten onverkort gelaten, komt de netto opbrengst van de vereffening toe aan de deelgenoten in * verhouding tot de boekwaarde op dat ogenblik van hun inbreng.”\n\n; VOOR ANALYTISCH UITTREKSEL\n\n! Samen hiermee neergelegd:\n\n- de expeditie van het proces-verbaal, inbegrepen verslag zitting Raad voor Maatschappelijk Welzijn van 13 ‘december 2012, voorontwerp van de statuterwijziging, proces-verbaal van de zitting van de Raad van Bestuur dd 17 december 2012 en aanwezigheidslijst Buitengewone Algemene Vergadering dd 18 december 2012;\n\nOp de laatste biz. van Luik B vermelden : Recto : Naam en hoedanigheid van de instrumenterende notaris, hetzij van de perso(o)n(en) bevoegd de rechtspersoon ten aanzien van derden te vertegenwoordigen\n\nVerso : Naam en handtekening\n\nBijlagen bij het Belgisch Staatsblad - 29\u002F01\u002F2013 - Annexes du Moniteur belge\f\n\n- de coördinatie der statuten\n\nLuik B - Vervolg\n\n‘+ Voor-\n\nbehouden\n\naan het\n\nBelgisch\n\nStaatsblad |\n\nGeassocieerd notaris Jeroen Parmentier\n\nRecto : Naam en hoedanigheid van de instrumenterende notaris, hetzij van de perso{o)nten)\n\nbevoegd de rechtspersoon ten aanzien van derden te vertegenwoordigen Luik B vermelden : Op de laatste biz. van\n\nm en handtekening Verso : Naai\n\nBijlagen bij het Belgisch Staatsblad - 29\u002F01\u002F2013 - Annexes du Moniteur belge","2013-01-29\u002F0016882","https:\u002F\u002Fwww.ejustice.just.fgov.be\u002Ftsv_pdf\u002F2013\u002F01\u002F29\u002F13016882.pdf","BENAMING - STATUTEN (VERTALING, COÖRDINATIE, OVERIGE WIJZIGINGEN, …)","BE_TU9OSVRPUiMvdHN2X3BkZi8yMDEzLzAxLzI5LzEzMDE2ODgyLnBkZg",{"results":232,"total":112,"total_active":112,"total_inactive":115},[233,242],{"number":234,"name":235,"secondary_names":236,"acronym":12,"activities":237,"fields_of_activity":239,"local_activities":240,"date_of_creation":21,"date_of_creation_format":48,"status":41,"cessation_date":12,"cessation_date_format":48,"address_line_1":52,"address_line_2":12,"postal_code":53,"city":54,"country":55,"country_code":6},"2.161.542.555","AZ Jan Palfijn Gent AV - site Watersportbaan",[],[238],{"code":24,"name":25,"classification":26},[31],[241],{"code":34,"name":35,"classification":36},{"number":243,"name":244,"secondary_names":245,"acronym":12,"activities":246,"fields_of_activity":248,"local_activities":249,"date_of_creation":21,"date_of_creation_format":48,"status":41,"cessation_date":12,"cessation_date_format":48,"address_line_1":251,"address_line_2":12,"postal_code":53,"city":54,"country":55,"country_code":6},"2.161.543.050","AZ Jan Palfijn Gent AV - site Fabiolalaan",[],[247],{"code":24,"