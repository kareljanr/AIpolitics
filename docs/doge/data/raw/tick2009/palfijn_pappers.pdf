primary-700 active:bg-primary-800 ring-[1px] ring-white hover:ring-neutral-100 active:ring-neutral-200 !bg-transparent" data-v-fb5ae404><div class="flex items-center flex-row"><!----><!----><div style="width:20px;height:20px;" class="inline-flex items-center justify-center pointer-events-none"><svg class="svg-inline--fa fa-xmark fa-fw text-white hover:text-neutral-100 active:text-neutral-200" style="font-size:16px;" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="xmark" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path class="" style="" fill="currentColor" d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"></path></svg></div></div><!----></button></div><div class="pointer-events-none absolute inset-0 bg-primary-900 [clip-path:polygon(82%_0%,100%_0%,100%_100%,75%_100%)]" data-v-fb5ae404></div><div class="relative z-10 flex h-full px-md" data-v-fb5ae404><div class="w-3/5 flex items-center justify-center" data-v-fb5ae404><div class="my-lg py-sm pl-[147px] flex flex-col justify-between gap-lg" data-v-fb5ae404><div data-v-fb5ae404><p class="text-primary-500 arvo text-xl font-normal leading-7" data-v-fb5ae404>MCP</p><p class="my-xs text-[16px] leading-[24px] xl:text-[18px] xl:leading-[28px] font-medium" data-v-fb5ae404>Test gratis de Pappers MCP en haal het beste uit uw AI</p><p class="text-[12px] leading-[16px] xl:text-[14px] xl:leading-[20px] font-normal" data-v-fb5ae404>Directe verbinding tussen AI en alle gegevens van Pappers BE: bestuurders, aandeelhouders, publicaties, jaarrekeningen, enz...</p><p class="mt-xs text-[12px] leading-[16px] xl:text-[14px] xl:leading-[20px] font-normal" data-v-fb5ae404>Het beste van twee werelden: de redenering van AI gecombineerd met de betrouwbaarheid van Pappers-gegevens voor concrete en operationele toepassingen.</p></div><a href="/nl/mcp?utm_source=pappers_be_nl&amp;utm_medium=bandeau-page-entreprise&amp;utm_campaign=lancement-mcp-be" rel="noopener noreferrer" target="_blank" class="flex select-none items-center justify-center p-sm ring-inset h-fit rounded-sm w-fit cursor-pointer bg-white hover:bg-neutral-50 active:bg-neutral-100 ring-[1px] ring-primary-500" icon-position="right" data-v-fb5ae404><div class="flex items-center flex-row"><!----><span class="label-md text-primary-500 px-xs">Meer weten <!--[--><!--]--></span><div style="width:20px;height:20px;" class="inline-flex items-center justify-center pointer-events-none"><svg class="svg-inline--fa fa-arrow-right fa-fw text-primary-500" style="font-size:16px;" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="arrow-right" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path class="" style="" fill="currentColor" d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"></path></svg></div></div><!----></a></div></div><div class="w-2/5 h-full flex flex-col pt-lg justify-center items-center overflow-hidden" data-v-fb5ae404><img onerror="this.setAttribute(&#39;data-error&#39;, 1)" width="480" alt="MCP banner" data-nuxt-img srcset="/img/banners/mcp.svg 1x, /img/banners/mcp.svg 2x" class="object-contain object-bottom rounded-t-sm" src="/img/banners/mcp.svg" data-v-fb5ae404></div></div></div><div class="h-screen flex flex-col justify-between"><!--[--><!--]--><div class="flex flex-1"><!----><div class="flex flex-col flex-1 h-full min-w-0"><div class="relative"><header class="w-full py-md px-lg space-y-md"><div class="flex items-center justify-between w-full"><a href="/nl"><img src="/img/pappers/logos/logo_pappers_be_full_blue.svg" alt="Pappers Be logo" class="!max-w-none"></a><div