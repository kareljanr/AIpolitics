con-full e-flex e-con e-parent\" data-id=\"c1b03d4\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-a6ef00e e-con-full elementor-hidden-tablet elementor-hidden-mobile e-flex e-con e-child\" data-id=\"a6ef00e\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-1f44cc9 e-con-full e-flex e-con e-child\" data-id=\"1f44cc9\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-517f87b elementor-widget elementor-widget-image\" data-id=\"517f87b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t<figure class=\"wp-caption\">\n\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"534\" src=\"https:\/\/leseta.be\/wp-content\/uploads\/2026\/05\/Axedis-53-1024x683.jpg\" class=\"attachment-large size-large wp-image-5266384\" alt=\"\" srcset=\"https:\/\/leseta.be\/wp-content\/uploads\/2026\/05\/Axedis-53-1024x683.jpg 1024w, https:\/\/leseta.be\/wp-content\/uploads\/2026\/05\/Axedis-53-300x200.jpg 300w, https:\/\/leseta.be\/wp-content\/uploads\/2026\/05\/Axedis-53-768x512.jpg 768w, https:\/\/leseta.be\/wp-content\/uploads\/2026\/05\/Axedis-53.jpg 1200w\" sizes=\"(max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t<figcaption class=\"widget-image-caption wp-caption-text\">Axedis<\/figcaption>\n\t\t\t\t\t\t\t\t\t\t<\/figure>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-2f3087c e-con-full e-flex e-con e-child\" data-id=\"2f3087c\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-13ac565 e-flex e-con-boxed e-con e-child\" data-id=\"13ac565\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-40dd7cb elementor-widget elementor-widget-heading\" data-id=\"40dd7cb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Une contribution aux obligations d\u2019emploi<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-be7686d elementor-widget elementor-widget-text-editor\" data-id=\"be7686d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Le recours aux ETA peut <\/span><b>\u00eatre valoris\u00e9 et comptabilis\u00e9 dans le cadre de vos obligations l\u00e9gales d\u2019emploi de personnes en situation de handicap<\/b><span style=\"font-weight: 400;\">, en coh\u00e9rence avec les objectifs des politiques publiques. En int\u00e9grant syst\u00e9matiquement les ETA dans vos proc\u00e9dures, en recourant notamment \u00e0 des r\u00e9servations de march\u00e9s ou\u00a0 des clauses sociales, vous transformez une obligation l\u00e9gale en <\/span><b>outil concret d\u2019action publique responsable<\/b><span style=\"font-weight: 400;\">.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-dcce7c3 elementor-arrows-position-inside elementor-widget elementor-widget-loop-carousel\" data-id=\"dcce7c3\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;_skin&quot;:&quot;post_taxonomy&quot;,&quot;template_id&quot;:&quot;5263935&quot;,&quot;slides_to_show&quot;:&quot;4&quot;,&quot;slides_to_show_tablet&quot;:&quot;4&quot;,&quot;slides_to_scroll&quot;:&quot;4&quot;,&quot;slides_to_show_mobile&quot;:&quot;1&quot;,&quot;edit_handle_selector&quot;:&quot;.elementor-loop-container&quot;,&quot;autoplay&quot;