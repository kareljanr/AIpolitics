[{"id":5266627,"date":"2026-05-18T15:19:17","date_gmt":"2026-05-18T13:19:17","guid":{"rendered":"https:\/\/leseta.be\/?page_id=5266627"},"modified":"2026-06-08T13:53:48","modified_gmt":"2026-06-08T11:53:48","slug":"faq","status":"publish","type":"page","link":"https:\/\/leseta.be\/faq\/","title":{"rendered":"FAQ"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"5266627\" class=\"elementor elementor-5266627\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4349ff2 e-flex e-con-boxed e-con e-parent\" data-id=\"4349ff2\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-01a6475 e-con-full e-flex e-con e-child\" data-id=\"01a6475\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-bc93f80 elementor-widget elementor-widget-heading\" data-id=\"bc93f80\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">FAQ<\/h1>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-bd15440 elementor-widget elementor-widget-text-editor\" data-id=\"bd15440\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"standard-markdown grid-cols-1 grid gap-4 [&amp;_&gt;_*]:min-w-0\"><div class=\"standard-markdown grid-cols-1 grid gap-4 [&amp;_&gt;_*]:min-w-0\"><p>Toutes les questions les plus fr\u00e9quentes<\/p><\/div><\/div>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-f9de1c3 e-con-full e-flex e-con e-parent\" data-id=\"f9de1c3\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-55ba11c e-flex e-con-boxed e-con e-child\" data-id=\"55ba11c\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-66d38e0 e-con-full e-flex e-con e-child\" data-id=\"66d38e0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-9635e70 e-con-full e-flex e-con e-child\" data-id=\"9635e70\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6c290a8 elementor-widget elementor-widget-heading\" data-id=\"6c290a8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Questions fr\u00e9quentes sur les ETA<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e1c213f elementor-widget elementor-widget-spacer\" data-id=\"e1c213f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a50b02a elementor-widget elementor-widget-n-accordion\" data-id=\"a50b02a\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;default_state&quot;:&quot;all_collapsed&quot;,&quot;max_items_expended&quot;:&quot;one&quot;,&quot;n_accordion_animation_duration&quot;:{&quot;unit&quot;:&quot;ms&quot;,&quot;size&quot;:400,&quot;sizes&quot;:[]}}\" data-widget_type=\"nested-accordion.default\">\n\t\t\t\t\t\t\t<div class=\"e-n-accordion\" aria-label=\"Accordion. Open links with Enter or Space, close with Escape, and navigate with Arrow Keys\">\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1730\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"1\" tabindex=\"0\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1730\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Qu\u2019est ce qu\u2019une ETA ?  <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1730\" class=\"elementor-element elementor-element-cca4286 e-con-full e-flex e-con e-child\" data-id=\"cca4286\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-954e10d elementor-widget elementor-widget-text-editor\" data-id=\"954e10d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Une entreprise de travail adapt\u00e9 (ETA) est une entreprise active dans l\u2019\u00e9conomie sociale qui emploie majoritairement des personnes en situation de handicap.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><span style=\"font-weight: 400;\"> Elle combine une mission sociale forte \u2014 favoriser l\u2019inclusion professionnelle \u2014 avec une activit\u00e9 \u00e9conomique r\u00e9elle, en proposant des services et produits de qualit\u00e9 \u00e0 diff\u00e9rents clients (particuliers, entreprises et pouvoirs publics).<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d947ff9 elementor-widget elementor-widget-button\" data-id=\"d947ff9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/leseta.be\/quest-ce-quune-eta\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Qu'est-ce qu'une ETA ?<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1731\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"2\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1731\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> O\u00f9 trouver une ETA ? <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1731\" class=\"elementor-element elementor-element-d027402 e-con-full e-flex e-con e-child\" data-id=\"d027402\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7a0aaba elementor-widget elementor-widget-text-editor\" data-id=\"7a0aaba\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Vous pouvez facilement trouver une ETA\u00a0 en consultant l\u2019<a href=\"\/annuaire-eta\">annuaire des ETA<\/a>. Il reprend la liste des entreprises de travail adapt\u00e9 et leurs secteurs d\u2019activit\u00e9. Vous pouvez \u00e9galement faire une recherche affin\u00e9e via le moteur de recherche du site en recherchant un service pr\u00e9cis que vous cherchez \u00e0 faire r\u00e9aliser par une ETA ou une ETA par localisation ou mot cl\u00e9. <\/span><span style=\"font-weight: 400;\"><br \/><\/span><span style=\"font-weight: 400;\">Ces outils vous permettent d\u2019identifier rapidement l\u2019entreprise la plus adapt\u00e9e \u00e0 votre demande.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-096e4d9 elementor-widget elementor-widget-button\" data-id=\"096e4d9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"\/annuaire-eta\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">D\u00e9couvrir l'annuaire<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1732\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"3\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1732\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Quels types de services peut on confier \u00e0 une ETA ? <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1732\" class=\"elementor-element elementor-element-f4119e5 e-con-full e-flex e-con e-child\" data-id=\"f4119e5\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7249f60 elementor-widget elementor-widget-text-editor\" data-id=\"7249f60\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Les ETA couvrent une tr\u00e8s large gamme d\u2019activit\u00e9s pour les entreprises priv\u00e9es, les particuliers ou les particuliers : entretien d\u2019espaces verts, blanchisserie, conditionnement, logistique, menuiserie, \u2026 Vous pouvez consulter les diff\u00e9rentes activit\u00e9s r\u00e9alis\u00e9es par une ETA en vous rendant sur la page \u201cDomaines d\u2019activit\u00e9s\u201d.\u00a0<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-24771be elementor-widget elementor-widget-button\" data-id=\"24771be\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/leseta.be\/secteur\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">D\u00e9couvrir les secteurs d'activit\u00e9<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1733\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"4\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1733\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> En tant que particulier, puis-je faire appel \u00e0 une ETA ? <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1733\" class=\"elementor-element elementor-element-c7f95db e-con-full e-flex e-con e-child\" data-id=\"c7f95db\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-87dc1ed elementor-widget elementor-widget-text-editor\" data-id=\"87dc1ed\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Oui. M\u00eame si beaucoup d\u2019ETA travaillent avec des entreprises, elles proposent \u00e9galement des services accessibles aux particuliers.Vous pouvez consulter l\u2019annuaire des ETA ou la liste des domaines d\u2019activit\u00e9s pour voir quelle ETA correspond \u00e0 votre besoin. Vous trouverez \u00e9galement des informations sur les services aux particuliers dans la rubrique \u201cJe suis un particulier\u201d.\u00a0<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a7d32a elementor-widget elementor-widget-button\" data-id=\"1a7d32a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/leseta.be\/je-suis\/je-suis-un-particulier\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">En savoir plus<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1734\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"5\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1734\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> En tant qu\u2019entreprise, puis-je faire appel \u00e0 une ETA pour du service ou de la sous-traitance ? <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1734\" class=\"elementor-element elementor-element-5d61bec e-con-full e-flex e-con e-child\" data-id=\"5d61bec\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-e1a83de elementor-widget elementor-widget-text-editor\" data-id=\"e1a83de\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Oui. Les ETA sont des partenaires privil\u00e9gi\u00e9s pour votre sous-traitance et sous-traitance industrielle. Vous pouvez consulter l\u2019annuaire des ETA ou la liste des domaines d\u2019activit\u00e9s pour voir quelle ETA correspond \u00e0 votre besoin ou encore rechercher un service dans moteur de recherche du site.\u00a0<\/span><\/p><p><span style=\"font-weight: 400;\">Vous pouvez \u00e9galement conclure un contrat d\u2019entreprise avec une ETA qui d\u00e9tachera du personnel dans vos locaux, le tout encadr\u00e9 par l\u2019ETA.\u00a0<\/span><\/p><p><span style=\"font-weight: 400;\">Vous trouverez des informations sur les services aux entreprises dans la rubrique \u201cJe suis une entreprise\u201d. <\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d293981 elementor-widget elementor-widget-button\" data-id=\"d293981\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/leseta.be\/je-suis\/je-suis-une-entreprise\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">En savoir plus pour les entreprises<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1735\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"6\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1735\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> En tant que pouvoir public, puis-je faire appel \u00e0 une ETA dans des march\u00e9s publics ? <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1735\" class=\"elementor-element elementor-element-355f262 e-con-full e-flex e-con e-child\" data-id=\"355f262\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-590fac0 elementor-widget elementor-widget-text-editor\" data-id=\"590fac0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Oui, tout \u00e0 fait. Les ETA sont en capacit\u00e9 de r\u00e9pondre \u00e0 des march\u00e9s publics techniques de fournitures et de services. Vous pouvez trouver la liste des ETA et leurs secteurs d\u2019activit\u00e9s sur l\u2019annuaire des ETA ou vous rendre sur la page \u201cdomaines d\u2019activit\u00e9s\u201d. Vous pouvez \u00e9galement faire une recherche par mot cl\u00e9 sur le moteur de recherche du site. Vous souhaitez favoriser les ETA dans vos march\u00e9s publics ? Il existe plusieurs possibilit\u00e9s. Pour ce faire, rendez-vous sur la page \u201cJe suis un pouvoir public\u201d. Vous y trouverez \u00e9galement toute l\u2019information n\u00e9cessaire pour valoriser le recours \u00e0 des ETA pour votre quota de personnes en situation de handicap. <\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-c8b1ab3 elementor-widget elementor-widget-button\" data-id=\"c8b1ab3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/leseta.be\/je-suis\/je-suis-une-administration-publique\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">En savoir plus pour les administrations publiques<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1736\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"7\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1736\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Je souhaite travailler dans une ETA, comment m\u2019y prendre ?  <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1736\" class=\"elementor-element elementor-element-dcd7917 e-con-full e-flex e-con e-child\" data-id=\"dcd7917\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-03fac4f elementor-widget elementor-widget-text-editor\" data-id=\"03fac4f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Si tout le monde peut travailler en ETA, leur mission sociale prioritaire est de donner de l\u2019emploi aux personnes en situation de handicap \u00e9loign\u00e9es de l\u2019emploi. Si vous souhaitez travailler en ETA en tant que personne en situation de handicap, vous devez remplir certains crit\u00e8res que vous trouverez sur la page \u201cje suis un futur travailleur\u201d. Si vous remplissez ces crit\u00e8res, vous pouvez regarder sur l\u2019annuaire des ETA, l\u2019entreprise la plus proche de chez vous et envoyer votre CV ou lettre de motivation ou les contacter directement.\u00a0<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e76a64c elementor-widget elementor-widget-button\" data-id=\"e76a64c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/leseta.be\/travailler-en-eta\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">En savoir plus pour Travailler en ETA<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1737\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"8\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1737\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Qu\u2019est ce que des entreprises d\u2019\u00e9conomie sociale ?  <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1737\" class=\"elementor-element elementor-element-7c13dfb e-con-full e-flex e-con e-child\" data-id=\"7c13dfb\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3bc1726 elementor-widget elementor-widget-text-editor\" data-id=\"3bc1726\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Les ETA font partie de l\u2019\u00e9conomie sociale, qui repose sur trois piliers essentiels :<\/span><\/p><ol><li><span style=\"font-weight: 400;\"> Une finalit\u00e9 sociale avant le profit<\/span><b><br \/><\/b><span style=\"font-weight: 400;\"> Les entreprises d\u2019\u00e9conomie sociale sont rentables, mais leur priorit\u00e9 est l\u2019impact social. Elles r\u00e9investissent leurs b\u00e9n\u00e9fices pour d\u00e9velopper leurs activit\u00e9s plut\u00f4t que de r\u00e9mun\u00e9rer des actionnaires. La mission sociale prioritaire est de mettre \u00e0 l\u2019emploi des personnes en situation de handicap \u00e9loign\u00e9es du travail.\u00a0<\/span><\/li><li><span style=\"font-weight: 400;\"> Une gouvernance d\u00e9mocratique<\/span><b><br \/><\/b><span style=\"font-weight: 400;\">Le fonctionnement des organes de d\u00e9cisions (Conseil d\u2019Administration et Assembl\u00e9es G\u00e9n\u00e9rales) repose sur le principe \u00ab une personne = une voix \u00bb. Les d\u00e9cisions ne d\u00e9pendent pas du capital d\u00e9tenu, mais d\u2019une logique participative impliquant les parties prenantes.<\/span><\/li><li><span style=\"font-weight: 400;\"> Une autonomie de gestion<\/span><b><br \/><\/b><span style=\"font-weight: 400;\"> M\u00eame si elles peuvent b\u00e9n\u00e9ficier de financements publics, ces entreprises restent ind\u00e9pendantes dans leurs d\u00e9cisions.<\/span><\/li><\/ol>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t\t<details id=\"e-n-accordion-item-1738\" class=\"e-n-accordion-item\" >\n\t\t\t\t<summary class=\"e-n-accordion-item-title\" data-accordion-index=\"9\" tabindex=\"-1\" aria-expanded=\"false\" aria-controls=\"e-n-accordion-item-1738\" >\n\t\t\t\t\t<span class='e-n-accordion-item-title-header'><div class=\"e-n-accordion-item-title-text\"> Qu\u2019est ce que l\u2019Eweta ? <\/div><\/span>\n\t\t\t\t\t\t\t<span class='e-n-accordion-item-title-icon'>\n\t\t\t<span class='e-opened' ><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t\t<span class='e-closed'><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg><\/span>\n\t\t<\/span>\n\n\t\t\t\t\t\t<\/summary>\n\t\t\t\t<div role=\"region\" aria-labelledby=\"e-n-accordion-item-1738\" class=\"elementor-element elementor-element-4065c4f e-con-full e-flex e-con e-child\" data-id=\"4065c4f\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-8a5142f elementor-widget elementor-widget-text-editor\" data-id=\"8a5142f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">L\u2019Eweta est la f\u00e9d\u00e9ration des entreprises de travail adapt\u00e9 en Wallonie et en Communaut\u00e9 germanophone.<\/span><\/p><p><span style=\"font-weight: 400;\">Elle repr\u00e9sente les ETA, d\u00e9fend leurs int\u00e9r\u00eats et valorise leur r\u00f4le aupr\u00e8s des pouvoirs publics, des entreprises et du grand public. C\u2019est l\u2019Eweta qui \u00e9dite ce site internet o\u00f9 les entreprises de travail adapt\u00e9 pr\u00e9sentent leurs activit\u00e9s. <\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9c4d854 elementor-widget elementor-widget-button\" data-id=\"9c4d854\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/leseta.be\/a-propos\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">A propos<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/details>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t<script type=\"application\/ld+json\">{\"@context\":\"https:\\\/\\\/schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Qu\\u2019est ce qu\\u2019une ETA ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Une entreprise de travail adapt\\u00e9 (ETA) est une entreprise active dans l\\u2019\\u00e9conomie sociale qui emploie majoritairement des personnes en situation de handicap. Elle combine une mission sociale forte \\u2014 favoriser l\\u2019inclusion professionnelle \\u2014 avec une activit\\u00e9 \\u00e9conomique r\\u00e9elle, en proposant des services et produits de qualit\\u00e9 \\u00e0 diff\\u00e9rents clients (particuliers, entreprises et pouvoirs publics).\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tQu'est-ce qu'une ETA ?\"}},{\"@type\":\"Question\",\"name\":\"O\\u00f9 trouver une ETA ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Vous pouvez facilement trouver une ETA\\u00a0 en consultant l\\u2019annuaire des ETA. Il reprend la liste des entreprises de travail adapt\\u00e9 et leurs secteurs d\\u2019activit\\u00e9. Vous pouvez \\u00e9galement faire une recherche affin\\u00e9e via le moteur de recherche du site en recherchant un service pr\\u00e9cis que vous cherchez \\u00e0 faire r\\u00e9aliser par une ETA ou une ETA par localisation ou mot cl\\u00e9. Ces outils vous permettent d\\u2019identifier rapidement l\\u2019entreprise la plus adapt\\u00e9e \\u00e0 votre demande.\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tD\\u00e9couvrir l'annuaire\"}},{\"@type\":\"Question\",\"name\":\"Quels types de services peut on confier \\u00e0 une ETA ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Les ETA couvrent une tr\\u00e8s large gamme d\\u2019activit\\u00e9s pour les entreprises priv\\u00e9es, les particuliers ou les particuliers : entretien d\\u2019espaces verts, blanchisserie, conditionnement, logistique, menuiserie, \\u2026 Vous pouvez consulter les diff\\u00e9rentes activit\\u00e9s r\\u00e9alis\\u00e9es par une ETA en vous rendant sur la page \\u201cDomaines d\\u2019activit\\u00e9s\\u201d.\\u00a0\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tD\\u00e9couvrir les secteurs d'activit\\u00e9\"}},{\"@type\":\"Question\",\"name\":\"En tant que particulier, puis-je faire appel \\u00e0 une ETA ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oui. M\\u00eame si beaucoup d\\u2019ETA travaillent avec des entreprises, elles proposent \\u00e9galement des services accessibles aux particuliers.Vous pouvez consulter l\\u2019annuaire des ETA ou la liste des domaines d\\u2019activit\\u00e9s pour voir quelle ETA correspond \\u00e0 votre besoin. Vous trouverez \\u00e9galement des informations sur les services aux particuliers dans la rubrique \\u201cJe suis un particulier\\u201d.\\u00a0\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tEn savoir plus\"}},{\"@type\":\"Question\",\"name\":\"En tant qu\\u2019entreprise, puis-je faire appel \\u00e0 une ETA pour du service ou de la sous-traitance ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oui. Les ETA sont des partenaires privil\\u00e9gi\\u00e9s pour votre sous-traitance et sous-traitance industrielle. Vous pouvez consulter l\\u2019annuaire des ETA ou la liste des domaines d\\u2019activit\\u00e9s pour voir quelle ETA correspond \\u00e0 votre besoin ou encore rechercher un service dans moteur de recherche du site.\\u00a0Vous pouvez \\u00e9galement conclure un contrat d\\u2019entreprise avec une ETA qui d\\u00e9tachera du personnel dans vos locaux, le tout encadr\\u00e9 par l\\u2019ETA.\\u00a0Vous trouverez des informations sur les services aux entreprises dans la rubrique \\u201cJe suis une entreprise\\u201d. \\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tEn savoir plus pour les entreprises\"}},{\"@type\":\"Question\",\"name\":\"En tant que pouvoir public, puis-je faire appel \\u00e0 une ETA dans des march\\u00e9s publics ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oui, tout \\u00e0 fait. Les ETA sont en capacit\\u00e9 de r\\u00e9pondre \\u00e0 des march\\u00e9s publics techniques de fournitures et de services. Vous pouvez trouver la liste des ETA et leurs secteurs d\\u2019activit\\u00e9s sur l\\u2019annuaire des ETA ou vous rendre sur la page \\u201cdomaines d\\u2019activit\\u00e9s\\u201d. Vous pouvez \\u00e9galement faire une recherche par mot cl\\u00e9 sur le moteur de recherche du site. Vous souhaitez favoriser les ETA dans vos march\\u00e9s publics ? Il existe plusieurs possibilit\\u00e9s. Pour ce faire, rendez-vous sur la page \\u201cJe suis un pouvoir public\\u201d. Vous y trouverez \\u00e9galement toute l\\u2019information n\\u00e9cessaire pour valoriser le recours \\u00e0 des ETA pour votre quota de personnes en situation de handicap. \\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tEn savoir plus pour les administrations publiques\"}},{\"@type\":\"Question\",\"name\":\"Je souhaite travailler dans une ETA, comment m\\u2019y prendre ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Si tout le monde peut travailler en ETA, leur mission sociale prioritaire est de donner de l\\u2019emploi aux personnes en situation de handicap \\u00e9loign\\u00e9es de l\\u2019emploi. Si vous souhaitez travailler en ETA en tant que personne en situation de handicap, vous devez remplir certains crit\\u00e8res que vous trouverez sur la page \\u201cje suis un futur travailleur\\u201d. Si vous remplissez ces crit\\u00e8res, vous pouvez regarder sur l\\u2019annuaire des ETA, l\\u2019entreprise la plus proche de chez vous et envoyer votre CV ou lettre de motivation ou les contacter directement.\\u00a0\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tEn savoir plus pour Travailler en ETA\"}},{\"@type\":\"Question\",\"name\":\"Qu\\u2019est ce que des entreprises d\\u2019\\u00e9conomie sociale ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Les ETA font partie de l\\u2019\\u00e9conomie sociale, qui repose sur trois piliers essentiels : Une finalit\\u00e9 sociale avant le profit Les entreprises d\\u2019\\u00e9conomie sociale sont rentables, mais leur priorit\\u00e9 est l\\u2019impact social. Elles r\\u00e9investissent leurs b\\u00e9n\\u00e9fices pour d\\u00e9velopper leurs activit\\u00e9s plut\\u00f4t que de r\\u00e9mun\\u00e9rer des actionnaires. La mission sociale prioritaire est de mettre \\u00e0 l\\u2019emploi des personnes en situation de handicap \\u00e9loign\\u00e9es du travail.\\u00a0 Une gouvernance d\\u00e9mocratiqueLe fonctionnement des organes de d\\u00e9cisions (Conseil d\\u2019Administration et Assembl\\u00e9es G\\u00e9n\\u00e9rales) repose sur le principe \\u00ab une personne = une voix \\u00bb. Les d\\u00e9cisions ne d\\u00e9pendent pas du capital d\\u00e9tenu, mais d\\u2019une logique participative impliquant les parties prenantes. Une autonomie de gestion M\\u00eame si elles peuvent b\\u00e9n\\u00e9ficier de financements publics, ces entreprises restent ind\\u00e9pendantes dans leurs d\\u00e9cisions.\"}},{\"@type\":\"Question\",\"name\":\"Qu\\u2019est ce que l\\u2019Eweta ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"L\\u2019Eweta est la f\\u00e9d\\u00e9ration des entreprises de travail adapt\\u00e9 en Wallonie et en Communaut\\u00e9 germanophone.Elle repr\\u00e9sente les ETA, d\\u00e9fend leurs int\\u00e9r\\u00eats et valorise leur r\\u00f4le aupr\\u00e8s des pouvoirs publics, des entreprises et du grand public. C\\u2019est l\\u2019Eweta qui \\u00e9dite ce site internet o\\u00f9 les entreprises de travail adapt\\u00e9 pr\\u00e9sentent leurs activit\\u00e9s. \\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tA propos\"}}]}<\/script>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-e145e1c e-con-full e-flex e-con e-child\" data-id=\"e145e1c\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-404ac7d elementor-widget elementor-widget-image\" data-id=\"404ac7d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" src=\"https:\/\/leseta.be\/wp-content\/uploads\/elementor\/thumbs\/L_Atelier-Salles-blanches-1-rke3wsf5bjm99u8ly5sppuat2bh3ub5bhx1m0ho0fc.jpg\" title=\"L\u2019Atelier \u2013 Salles blanches\" alt=\"Salles blanches - L&apos;Atelier\" loading=\"lazy\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-80a1dbb elementor-view-stacked elementor-position-inline-start elementor-absolute elementor-mobile-position-inline-start elementor-shape-circle elementor-widget elementor-widget-icon-box\" data-id=\"80a1dbb\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;_position&quot;:&quot;absolute&quot;}\" data-widget_type=\"icon-box.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-box-wrapper\">\n\n\t\t\t\t\t\t<div class=\"elementor-icon-box-icon\">\n\t\t\t\t<span  class=\"elementor-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-info-circle\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M256 8C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm0 110c23.196 0 42 18.804 42 42s-18.804 42-42 42-42-18.804-42-42 18.804-42 42-42zm56 254c0 6.627-5.373 12-12 12h-88c-6.627 0-12-5.373-12-12v-24c0-6.627 5.373-12 12-12h12v-64h-12c-6.627 0-12-5.373-12-12v-24c0-6.627 5.373-12 12-12h64c6.627 0 12 5.373 12 12v100h12c6.627 0 12 5.373 12 12v24z\"><\/path><\/svg>\t\t\t\t<\/span>\n\t\t\t<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-icon-box-content\">\n\n\t\t\t\t\t\t\t\t\t<h6 class=\"elementor-icon-box-title\">\n\t\t\t\t\t\t<span  >\n\t\t\t\t\t\t\tTout comprendre sur les ETA\t\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/h6>\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n\t\t\t\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-7668664 e-flex e-con-boxed e-con e-parent\" data-id=\"7668664\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-0938ed0 e-con-full e-flex e-con e-child\" data-id=\"0938ed0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-77864c4 elementor-widget elementor-widget-heading\" data-id=\"77864c4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Pr\u00eat.e \u00e0 faire appel \u00e0 une ETA ?<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3fe1b47 elementor-widget elementor-widget-text-editor\" data-id=\"3fe1b47\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\tD\u00e9couvrez toutes nos ETA ainsi que leurs services et produits.\n\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-779b30a e-con-full e-flex e-con e-child\" data-id=\"779b30a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-d8e6753 elementor-mobile-align-right elementor-widget elementor-widget-button\" data-id=\"d8e6753\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"\/annuaire-eta\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t<span class=\"elementor-button-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg>\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">D\u00e9couvrir les ETA<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d59e5a7 elementor-mobile-align-right elementor-widget elementor-widget-button\" data-id=\"d59e5a7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"\/secteur\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t<span class=\"elementor-button-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg>\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">D\u00e9couvrir les m\u00e9tiers et secteurs<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>FAQ Toutes les questions les plus fr\u00e9quentes Questions fr\u00e9quentes sur les ETA Qu\u2019est ce qu\u2019une ETA ? Une entreprise de travail adapt\u00e9 (ETA) est une entreprise active dans l\u2019\u00e9conomie sociale qui emploie majoritairement des personnes en situation de handicap. Elle combine une mission sociale forte \u2014 favoriser l\u2019inclusion professionnelle \u2014 avec une activit\u00e9 \u00e9conomique r\u00e9elle, [&hellip;]<\/p>\n","protected":false},"author":62,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_header_footer","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-5266627","page","type-page","status-publish","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/pages\/5266627","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/users\/62"}],"replies":[{"embeddable":true,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/comments?post=5266627"}],"version-history":[{"count":16,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/pages\/5266627\/revisions"}],"predecessor-version":[{"id":5267209,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/pages\/5266627\/revisions\/5267209"}],"wp:attachment":[{"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/media?parent=5266627"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":5266236,"date":"2026-05-11T16:44:39","date_gmt":"2026-05-11T14:44:39","guid":{"rendered":"https:\/\/leseta.be\/?page_id=5266236"},"modified":"2026-06-17T12:36:28","modified_gmt":"2026-06-17T10:36:28","slug":"un-futur-travailleur","status":"publish","type":"page","link":"https:\/\/leseta.be\/je-suis\/un-futur-travailleur\/","title":{"rendered":"Un futur travailleur"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"5266236\" class=\"elementor elementor-5266236\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-41ef659a e-flex e-con-boxed e-con e-parent\" data-id=\"41ef659a\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-31c46e59 e-con-full e-flex e-con e-child\" data-id=\"31c46e59\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3aecc38c elementor-widget elementor-widget-heading\" data-id=\"3aecc38c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">Travailler en entreprise de travail adapt\u00e9<\/h1>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4380373 elementor-widget elementor-widget-text-editor\" data-id=\"4380373\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>Je suis un futur travailleur<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-79035b4b e-con-full e-flex e-con e-parent\" data-id=\"79035b4b\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-78cdf20 e-flex e-con-boxed e-con e-child\" data-id=\"78cdf20\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-6cafaab7 e-con-full e-flex e-con e-child\" data-id=\"6cafaab7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-5f1920c2 e-con-full e-flex e-con e-child\" data-id=\"5f1920c2\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1616b450 elementor-widget elementor-widget-heading\" data-id=\"1616b450\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Travailler en ETA en Wallonie<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5f6a398e elementor-widget elementor-widget-text-editor\" data-id=\"5f6a398e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Les entreprises de travail adapt\u00e9 (ETA) offrent des opportunit\u00e9s d\u2019emploi \u00e0 des personnes qui rencontrent des difficult\u00e9s particuli\u00e8res pour acc\u00e9der au march\u00e9 du travail classique en raison d\u2019un handicap.<\/span><\/p><p><span style=\"font-weight: 400;\">Travailler en ETA, c\u2019est exercer un m\u00e9tier dans un cadre professionnel adapt\u00e9, tout en d\u00e9veloppant ses comp\u00e9tences et en participant \u00e0 une activit\u00e9 \u00e9conomique r\u00e9elle.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-406f59eb elementor-widget elementor-widget-button\" data-id=\"406f59eb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elemento