\t\t\t\t\t<\/p>\n\t\t\t\t\n\t\t\t<\/div>\n\t\t\t\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-6155a13e e-flex e-con-boxed e-con e-parent\" data-id=\"6155a13e\" data-element_type=\"container\" data-e-type=\"container\" id=\"travaillent\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-7eb666ba e-con-full e-flex e-con e-child\" data-id=\"7eb666ba\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-259044e5 elementor-widget elementor-widget-heading\" data-id=\"259044e5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Ils travaillent en ETA<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-28a56872 elementor-mobile-align-right elementor-hidden-mobile elementor-hidden-tablet elementor-hidden-desktop elementor-widget elementor-widget-button\" data-id=\"28a56872\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"#\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t<span class=\"elementor-button-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg>\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Toutes les Succes Stories<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-38ebabb0 e-con-full e-flex e-con e-child\" data-id=\"38ebabb0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3839a23b elementor-widget elementor-widget-text-editor\" data-id=\"3839a23b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"section-header\"><p class=\"section-description\">D\u00e9couvrez les parcours inspirants de travailleurs qui ont trouv\u00e9 leur place en ETA.<\/p><\/div>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-35a5cb9a e-con-full e-flex e-con e-child\" data-id=\"35a5cb9a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-797f8f72 e-con-full e-flex e-con e-child\" data-id=\"797f8f72\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<a class=\"elementor-element elementor-element-783d83fd e-con-full e-flex e-con e-child\" data-id=\"783d83fd\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-59a13c00 elementor-arrows-position-outside elementor-widget elementor-widget-loop-carousel\" data-id=\"59a13c00\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;template_id&quot;:&quot;5258369&quot;,&quot;slides_to_show_tablet&quot;:&quot;1&quot;,&quot;image_spacing_custom&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:30,&quot;sizes&quot;:[]},&quot;slides_to_show&quot;:&quot;2&quot;,&quot;_skin&quot;:&quot;post&quot;,&quot;slides_to_show_mobile&quot;:&quot;1&quot;,&quot;slides_to_scroll&quot;:&quot;1&quot;,&quot;edit_handle_selector&quot;:&quot;.elementor-loop-container&quot;,&quot;autoplay&quot;:&quot;yes&quot;,&quot;autoplay_speed&quot;:5000,&quot;pause_on_hover&quot;:&quot;yes&quot;,&quot;pause_on_interaction&quot;:&quot;yes&quot;,&quot;infinite&quot;:&quot;yes&quot;,&quot;speed&quot;:500,&quot;offset_sides&quot;:&quot;none&quot;,&quot;arrows&quot;:&quot;yes&quot;,&quot;image_spacing_custom_tablet&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;image_spacing_custom_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]}}\" data-widget_type=\"loop-carousel.post\">\n\t\t\t\t\t\t\t<div class=\"swiper elementor-loop-container elementor-grid\" role=\"list\" dir=\"ltr\">\n\t\t\t\t<div class=\"swiper-wrapper\" aria-live=\"off\">\n\t\t\t\t<div data-elementor-type=\"loop-item\" data-elementor-id=\"5258369\" class=\"elementor elementor-5258369 swiper-slide e-loop-item e-loop-item-5266444 post-5266444 temoignage type-temoignage status-publish hentry affichage-page-travailler-en-eta\" data-elementor-post-type=\"elementor_library\" role=\"group\" aria-roledescription=\"slide\" data-custom-edit-handle=\"1\">\n\t\t\t<div class=\"elementor-element elementor-element-478c233 e-flex e-con-boxed e-con e-parent\" data-id=\"478c233\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-20a701d elementor-view-stacked elementor-shape-circle elementor-widget elementor-widget-icon\" data-id=\"20a701d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-quote-left\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a48c8b elementor-widget elementor-widget-testimonial\" data-id=\"1a48c8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"testimonial.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-wrapper\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-content\">Travailler en tant qu\u2019assistante sociale dans une ETA c\u2019est apporter mon soutien aux travailleurs tant sur le plan administratif que personnel. C\u2019est accueillir chaque personne avec sa singularit\u00e9 et tenter de trouver avec elle une issue favorable \u00e0 sa probl\u00e9matique. C\u2019est aussi de l\u2019\u00e9coute, du dialogue, du respect \u2026<br \/>\r\nMais c\u2019est aussi partager le quotidien d\u2019\u00eatres humains courageux qui, malgr\u00e9 leur situation de handicap, contribue \u00e0 faire vivre l\u2019entreprise et par extension notre soci\u00e9t\u00e9 toute enti\u00e8re.<br \/>\r\nEn conclusion c\u2019est une aventure humaine enrichissante o\u00f9 le ma\u00eetre mot est la tol\u00e9rance.\u201d<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-testimonial-meta\">\n\t\t\t\t<div class=\"elementor-testimonial-meta-inner\">\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-name\">Orlane V., Assistante sociale<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div data-elementor-type=\"loop-item\" data-elementor-id=\"5258369\" class=\"elementor elementor-5258369 swiper-slide e-loop-item e-loop-item-5266442 post-5266442 temoignage type-temoignage status-publish hentry affichage-page-travailler-en-eta\" data-elementor-post-type=\"elementor_library\" role=\"group\" aria-roledescription=\"slide\" data-custom-edit-handle=\"1\">\n\t\t\t<div class=\"elementor-element elementor-element-478c233 e-flex e-con-boxed e-con e-parent\" data-id=\"478c233\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-20a701d elementor-view-stacked elementor-shape-circle elementor-widget elementor-widget-icon\" data-id=\"20a701d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-quote-left\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a48c8b elementor-widget elementor-widget-testimonial\" data-id=\"1a48c8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"testimonial.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-wrapper\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-content\">Au travail, je suis toujours souriant, enthousiaste et de bonne humeur. Lors de la r\u00e9cente signature de mon CDI, j'\u00e9tais \"heureux comme un pape\" !<br \/>\r\nPour moi, c'est une v\u00e9ritable reconversion professionnelle; apr\u00e8s un important accident de camion, j'ai obtenu obtenu un poste adapt\u00e9 dans une ETA. Gr\u00e2ce \u00e0 ma d\u00e9brouillardise et ma volont\u00e9 d\u2019apprendre, j'assure avec succ\u00e8s les t\u00e2ches qui me sont confi\u00e9es ... et toujours avec la banane !<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-testimonial-meta\">\n\t\t\t\t<div class=\"elementor-testimonial-meta-inner\">\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-name\">Louis, travailleur<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div data-elementor-type=\"loop-item\" data-elementor-id=\"5258369\" class=\"elementor elementor-5258369 swiper-slide e-loop-item e-loop-item-684488 post-684488 temoignage type-temoignage status-publish has-post-thumbnail hentry affichage-page-travailler-en-eta\" data-elementor-post-type=\"elementor_library\" role=\"group\" aria-roledescription=\"slide\" data-custom-edit-handle=\"1\">\n\t\t\t<div class=\"elementor-element elementor-element-478c233 e-flex e-con-boxed e-con e-parent\" data-id=\"478c233\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-20a701d elementor-view-stacked elementor-shape-circle elementor-widget elementor-widget-icon\" data-id=\"20a701d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-quote-left\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a48c8b elementor-widget elementor-widget-testimonial\" data-id=\"1a48c8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"testimonial.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-wrapper\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-content\">J'ai commenc\u00e9 comme technicien de surface puis j'ai eu un probl\u00e8me de dos. J'ai alors commenc\u00e9 come chauffeur pour transporter le mat\u00e9riel (...) Les avantages, c'est que j'ai un accompagnement psychosocial et que je peux aller voir quand j'ai des soucis ou des probl\u00e8mes. <\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-testimonial-meta elementor-has-image elementor-testimonial-image-position-aside\">\n\t\t\t\t<div class=\"elementor-testimonial-meta-inner\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-image\">\n\t\t\t\t\t\t\t<img decoding=\"async\" width=\"300\" height=\"169\" src=\"https:\/\/leseta.be\/wp-content\/uploads\/2022\/09\/27-300x169.png\" class=\"attachment-medium size-medium wp-image-684606\" alt=\"\" srcset=\"https:\/\/leseta.be\/wp-content\/uploads\/2022\/09\/27-300x169.png 300w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/09\/27-1024x576.png 1024w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/09\/27-768x432.png 768w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/09\/27-240x135.png 240w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/09\/27.png 1200w\" sizes=\"(max-width: 300px) 100vw, 300px\" \/>\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-name\">Thierre Petit<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-job\">Travailleur chez Village n\u00b01 Entreprises<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div data-elementor-type=\"loop-item\" data-elementor-id=\"5258369\" class=\"elementor elementor-5258369 swiper-slide e-loop-item e-loop-item-621216 post-621216 temoignage type-temoignage status-publish has-post-thumbnail hentry affichage-page-temoignage affichage-page-travailler-en-eta\" data-elementor-post-type=\"elementor_library\" role=\"group\" aria-roledescription=\"slide\" data-custom-edit-handle=\"1\">\n\t\t\t<div class=\"elementor-element elementor-element-478c233 e-flex e-con-boxed e-con e-parent\" data-id=\"478c233\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-20a701d elementor-view-stacked elementor-shape-circle elementor-widget elementor-widget-icon\" data-id=\"20a701d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-quote-left\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a48c8b elementor-widget elementor-widget-testimonial\" data-id=\"1a48c8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"testimonial.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-wrapper\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-content\">Partant bient\u00f4t \u00e0 la retraite, j'ai d\u00e9but\u00e9 ma carri\u00e8re en 1994 dans une ETA. J'ai d'abord travaill\u00e9 dans l'atelier avant d'apprendre le m\u00e9tier de garnisseur. Durant mes 28 ann\u00e9es au sein de l'entreprise, J'ai eu la chance de r\u00e9parer de nombreux si\u00e8ges dont ceux de l'h\u00f4pital ERASME, mais ce qui restera \u00e0 jamais grav\u00e9, c'est la r\u00e9paration des fauteuils et divans de la Princesse Lilian de Belgique, rien que \u00e7a !<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-testimonial-meta elementor-has-image elementor-testimonial-image-position-aside\">\n\t\t\t\t<div class=\"elementor-testimonial-meta-inner\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-image\">\n\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"300\" height=\"169\" src=\"https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Hunnelle-300x169.png\" class=\"attachment-medium size-medium wp-image-621217\" alt=\"\" srcset=\"https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Hunnelle-300x169.png 300w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Hunnelle-1024x576.png 1024w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Hunnelle-768x432.png 768w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Hunnelle-240x135.png 240w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Hunnelle.png 1200w\" sizes=\"(max-width: 300px) 100vw, 300px\" \/>\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-name\">Patrick<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-job\">Travailleur<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div data-elementor-type=\"loop-item\" data-elementor-id=\"5258369\" class=\"elementor elementor-5258369 swiper-slide e-loop-item e-loop-item-621169 post-621169 temoignage type-temoignage status-publish has-post-thumbnail hentry affichage-page-daccueil affichage-page-temoignage affichage-page-travailler-en-eta\" data-elementor-post-type=\"elementor_library\" role=\"group\" aria-roledescription=\"slide\" data-custom-edit-handle=\"1\">\n\t\t\t<div class=\"elementor-element elementor-element-478c233 e-flex e-con-boxed e-con e-parent\" data-id=\"478c233\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-20a701d elementor-view-stacked elementor-shape-circle elementor-widget elementor-widget-icon\" data-id=\"20a701d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-quote-left\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a48c8b elementor-widget elementor-widget-testimonial\" data-id=\"1a48c8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"testimonial.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-wrapper\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-content\">Au travail, je suis toujours souriant, enthousiaste et de bonne humeur. Lors de la r\u00e9cente signature de mon CDI, j'\u00e9tais \"heureux comme un pape\" !<br \/>\r\nPour moi, c'est une v\u00e9ritable reconversion professionnelle; apr\u00e8s un important accident de camion, j'ai obtenu obtenu un poste adapt\u00e9 dans une ETA. Gr\u00e2ce \u00e0 ma d\u00e9brouillardise et ma volont\u00e9 d\u2019apprendre, j'assure avec succ\u00e8s les t\u00e2ches qui me sont confi\u00e9es ... et toujours avec la banane !<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-testimonial-meta elementor-has-image elementor-testimonial-image-position-aside\">\n\t\t\t\t<div class=\"elementor-testimonial-meta-inner\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-image\">\n\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"300\" height=\"169\" src=\"https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Saupont-300x169.png\" class=\"attachment-medium size-medium wp-image-621170\" alt=\"\" srcset=\"https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Saupont-300x169.png 300w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Saupont-1024x576.png 1024w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Saupont-768x432.png 768w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Saupont-240x135.png 240w, https:\/\/leseta.be\/wp-content\/uploads\/2022\/05\/Photo-temoigage-Louis-Saupont.png 1200w\" sizes=\"(max-width: 300px) 100vw, 300px\" \/>\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-name\">Louis<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-job\">Travailleur<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div data-elementor-type=\"loop-item\" data-elementor-id=\"5258369\" class=\"elementor elementor-5258369 swiper-slide e-loop-item e-loop-item-121361 post-121361 temoignage type-temoignage status-publish has-post-thumbnail hentry affichage-page-temoignage affichage-page-travailler-en-eta\" data-elementor-post-type=\"elementor_library\" role=\"group\" aria-roledescription=\"slide\" data-custom-edit-handle=\"1\">\n\t\t\t<div class=\"elementor-element elementor-element-478c233 e-flex e-con-boxed e-con e-parent\" data-id=\"478c233\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-20a701d elementor-view-stacked elementor-shape-circle elementor-widget elementor-widget-icon\" data-id=\"20a701d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-quote-left\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a48c8b elementor-widget elementor-widget-testimonial\" data-id=\"1a48c8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"testimonial.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-wrapper\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-content\">Je travaille depuis plus d'un an et demi en tant que peintre au sein du Moulin de la Hunelle. Peinture int\u00e9rieure et ext\u00e9rieure, tapissage, rev\u00eatement de sol, peinture fa\u00e7ade ou de corniche, j'ai plus d\u2019une corde \u00e0 mon arc.<br \/>\r\nC\u2019est que j'ai commenc\u00e9 \u00e0 l\u2019\u00e2ge de 17 ans dans le b\u00e2timent et n\u2019ai pas moins de 40 ans d\u2019exp\u00e9rience ! <br \/>\r\nJe suis au service des entreprises et particuliers.<br \/>\r\n<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-testimonial-meta elementor-has-image elementor-testimonial-image-position-aside\">\n\t\t\t\t<div class=\"elementor-testimonial-meta-inner\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-image\">\n\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"300\" height=\"169\" src=\"https:\/\/leseta.be\/wp-content\/uploads\/2021\/06\/15-300x169.png\" class=\"attachment-medium size-medium wp-image-121363\" alt=\"Photo de la pinture du Moulin de la Hunelle\" srcset=\"https:\/\/leseta.be\/wp-content\/uploads\/2021\/06\/15-300x169.png 300w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/06\/15-1024x576.png 1024w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/06\/15-768x432.png 768w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/06\/15-240x135.png 240w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/06\/15.png 1200w\" sizes=\"(max-width: 300px) 100vw, 300px\" \/>\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-name\">Jean-Claude<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-job\">Travailleur au Moulin de la Hunelle<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div data-elementor-type=\"loop-item\" data-elementor-id=\"5258369\" class=\"elementor elementor-5258369 swiper-slide e-loop-item e-loop-item-60220 post-60220 temoignage type-temoignage status-publish has-post-thumbnail hentry affichage-page-temoignage affichage-page-travailler-en-eta\" data-elementor-post-type=\"elementor_library\" role=\"group\" aria-roledescription=\"slide\" data-custom-edit-handle=\"1\">\n\t\t\t<div class=\"elementor-element elementor-element-478c233 e-flex e-con-boxed e-con e-parent\" data-id=\"478c233\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-20a701d elementor-view-stacked elementor-shape-circle elementor-widget elementor-widget-icon\" data-id=\"20a701d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-quote-left\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a48c8b elementor-widget elementor-widget-testimonial\" data-id=\"1a48c8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"testimonial.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-wrapper\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-content\">Je travaille pour Entranam depuis 42 ans et je m\u2019y sens toujours aussi bien. Engag\u00e9e initialement pour un travail avec la SNCB, j\u2019ai eu aussi l\u2019occasion de d\u00e9couvrir un tas d\u2019autres activit\u00e9s tant dans nos murs qu\u2019\u00e0 l\u2019ext\u00e9rieur. <\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-testimonial-meta elementor-has-image elementor-testimonial-image-position-aside\">\n\t\t\t\t<div class=\"elementor-testimonial-meta-inner\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-image\">\n\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"300\" height=\"169\" src=\"https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-300x169.jpg\" class=\"attachment-medium size-medium wp-image-60441\" alt=\"Photo d&apos;une travailleuse en sein de l&apos;Entreprise de travail adapt\u00e9 Entranam\" srcset=\"https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-300x169.jpg 300w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-1024x576.jpg 1024w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-768x432.jpg 768w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-750x422.jpg 750w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-1080x608.jpg 1080w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-980x551.jpg 980w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-480x270.jpg 480w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11-240x135.jpg 240w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/04\/11.jpg 1200w\" sizes=\"(max-width: 300px) 100vw, 300px\" \/>\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-name\">Jos\u00e9e Gigot<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-job\">Ouvri\u00e8re de production en \u00e9lectronique-connectique <\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div data-elementor-type=\"loop-item\" data-elementor-id=\"5258369\" class=\"elementor elementor-5258369 swiper-slide e-loop-item e-loop-item-23681 post-23681 temoignage type-temoignage status-publish has-post-thumbnail hentry affichage-page-temoignage affichage-page-travailler-en-eta\" data-elementor-post-type=\"elementor_library\" role=\"group\" aria-roledescription=\"slide\" data-custom-edit-handle=\"1\">\n\t\t\t<div class=\"elementor-element elementor-element-478c233 e-flex e-con-boxed e-con e-parent\" data-id=\"478c233\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-20a701d elementor-view-stacked elementor-shape-circle elementor-widget elementor-widget-icon\" data-id=\"20a701d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-wrapper\">\n\t\t\t<div class=\"elementor-icon\">\n\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-quote-left\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1a48c8b elementor-widget elementor-widget-testimonial\" data-id=\"1a48c8b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"testimonial.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-wrapper\">\n\t\t\t\t\t\t\t<div class=\"elementor-testimonial-content\">Sourd profond de naissance, j\u2019ai suivi une formation de menuisier.\u00a0 Apr\u00e8s 2 exp\u00e9riences de travail n\u00e9gatives en raison du manque de communication, j\u2019ai \u00e9t\u00e9 engag\u00e9 dans une ETA.<br \/>\r\nGr\u00e2ce \u00e0 l\u2019utilisation de la Langue des Signes, au climat de confiance et de communication, gr\u00e2ce aussi \u00e0 ma motivation, je me suis rapidement \u00e9panouis. Je suis devenu un des piliers de mon entreprise.<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-testimonial-meta elementor-has-image elementor-testimonial-image-position-aside\">\n\t\t\t\t<div class=\"elementor-testimonial-meta-inner\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-image\">\n\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"300\" height=\"169\" src=\"https:\/\/leseta.be\/wp-content\/uploads\/2021\/02\/2-300x169.png\" class=\"attachment-medium size-medium wp-image-27070\" alt=\"Photo du d\u00e9partement bois d&apos;une ETA\" srcset=\"https:\/\/leseta.be\/wp-content\/uploads\/2021\/02\/2-300x169.png 300w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/02\/2-1024x576.png 1024w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/02\/2-768x432.png 768w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/02\/2-1536x864.png 1536w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/02\/2-240x135.png 240w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/02\/2-1320x743.png 1320w, https:\/\/leseta.be\/wp-content\/uploads\/2021\/02\/2.png 1920w\" sizes=\"(max-width: 300px) 100vw, 300px\" \/>\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-details\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-name\">Patrick<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-testimonial-job\">Travailleur en entreprise de travail adapt\u00e9 - section bois<\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-prev\" role=\"button\" tabindex=\"0\" aria-label=\"Pr\u00e9c\u00e9dent\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-left\" viewBox=\"0 0 1000 1000\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M646 125C629 125 613 133 604 142L308 442C296 454 292 471 292 487 292 504 296 521 308 533L604 854C617 867 629 875 646 875 663 875 679 871 692 858 704 846 713 829 713 812 713 796 708 779 692 767L438 487 692 225C700 217 708 204 708 187 708 171 704 154 692 142 675 129 663 125 646 125Z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t\t<div class=\"elementor-swiper-button elementor-swiper-button-next\" role=\"button\" tabindex=\"0\" aria-label=\"Suivant\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-eicon-chevron-right\" viewBox=\"0 0 1000 1000\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M696 533C708 521 713 504 713 487 713 471 708 454 696 446L400 146C388 133 375 125 354 125 338 125 325 129 313 142 300 154 292 171 292 187 292 204 296 221 308 233L563 492 304 771C292 783 288 800 288 817 288 833 296 850 308 863 321 871 338 875 354 875 371 875 388 867 400 854L696 533Z\"><\/path><\/svg>\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9cd9172 elementor-mobile-align-right elementor-tablet-align-center elementor-hidden-desktop elementor-widget elementor-widget-button\" data-id=\"9cd9172\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"#\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t<span class=\"elementor-button-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg>\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Toutes les Succes Stories<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-1c2ba3d e-con-full e-flex e-con e-parent\" data-id=\"1c2ba3d\" data-element_type=\"container\" data-e-type=\"container\" id=\"criteres\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-3af904c e-con-full e-flex e-con e-child\" data-id=\"3af904c\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-09bd3a2 e-flex e-con-boxed e-con e-child\" data-id=\"09bd3a2\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-cc8bb7f elementor-widget elementor-widget-heading\" data-id=\"cc8bb7f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Les crit\u00e8res pour travailler en ETA<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2e6e1e5 elementor-widget elementor-widget-text-editor\" data-id=\"2e6e1e5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Pour travailler en ETA comme <\/span><b>travailleur de production<\/b><span style=\"font-weight: 400;\">, certaines conditions doivent toutefois \u00eatre remplies. Ces crit\u00e8res permettent de s\u2019assurer que les personnes qui y acc\u00e8dent sont bien celles pour lesquelles ce cadre de travail adapt\u00e9 est le plus pertinent.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-cb31d6c e-con-full e-flex e-con e-child\" data-id=\"cb31d6c\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1aad7f1 elementor-widget elementor-widget-heading\" data-id=\"1aad7f1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">1. Disposer d'une attestation<\/h3>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8aa36bb elementor-widget elementor-widget-text-editor\" data-id=\"8aa36bb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"benefit-card\"><div class=\"benefit-card\"><p>La personne doit d\u2019abord disposer d\u2019un <strong>document attestant d\u2019une situation de handicap ou d\u2019une aptitude au travail r\u00e9duite<\/strong>, d\u00e9livr\u00e9 par un organisme comp\u00e9tent.<\/p><\/div><\/div>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-6104715 e-con-full e-flex e-con e-child\" data-id=\"6104715\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4617ed6 elementor-widget elementor-widget-heading\" data-id=\"4617ed6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">2. R\u00e9pondre \u00e0 un crit\u00e8re unique ou deux cumulatifs<\/h3>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d0e02de elementor-widget elementor-widget-text-editor\" data-id=\"d0e02de\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"benefit-card\"><div class=\"benefit-card\"><p>Elle doit ensuite r\u00e9pondre soit \u00e0 au moins un crit\u00e8re unique, soit \u00e0 au moins deux crit\u00e8res cumulatifs pr\u00e9vus par la r\u00e9glementation.<\/p><\/div><\/div>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-0e53d62 e-con-full e-flex e-con e-child\" data-id=\"0e53d62\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-ccab0eb e-con-full e-grid e-con e-child\" data-id=\"ccab0eb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-1e6adac e-con-full e-flex e-con e-child\" data-id=\"1e6adac\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-25bf8ea elementor-widget elementor-widget-heading\" data-id=\"25bf8ea\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">1. Crit\u00e8res uniques<\/h3>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a2b6b84 elementor-widget elementor-widget-text-editor\" data-id=\"a2b6b84\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><i>(avoir au minimum 1 des items ci-dessous)<\/i><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Sortir de l\u2019enseignement secondaire sp\u00e9cialis\u00e9 de forme 2 ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Sortir de l\u2019enseignement secondaire sp\u00e9cialis\u00e9 de forme 3 sans en avoir obtenu la qualification ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">\u00catre \u00e2g\u00e9 de plus de cinquante ans ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">B\u00e9n\u00e9ficier d\u2019un minimum de neuf points permettant de pr\u00e9tendre \u00e0 l\u2019allocation d\u2019int\u00e9gration ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">B\u00e9n\u00e9ficier d\u2019une allocation de remplacement de revenu \u00e0 dur\u00e9e ind\u00e9termin\u00e9e ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Avoir fr\u00e9quent\u00e9 une section d\u2019accueil et de formation en entreprise de travail adapt\u00e9 ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Avoir travaill\u00e9 en entreprise de travail adapt\u00e9 comme travailleur de production subsidi\u00e9, quelle que soit la r\u00e9gion ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Avoir b\u00e9n\u00e9fici\u00e9 d\u2019une d\u00e9cision favorable de l\u2019Agence ou d\u2019un autre fonds belge pour travailler en entreprise de travail adapt\u00e9.<\/span><\/li><\/ul>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-1d9ba14 e-con-full e-flex e-con e-child\" data-id=\"1d9ba14\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9c604d6 elementor-widget elementor-widget-heading\" data-id=\"9c604d6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">2. Crit\u00e8res cumulatifs<\/h3>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3b4b4b7 elementor-widget elementor-widget-text-editor\" data-id=\"3b4b4b7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><i>(avoir au minimum 2 des items ci-dessous)<\/i><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">\u00catre \u00e2g\u00e9 de plus de 45 ans ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Avoir une p\u00e9riode d\u2019inactivit\u00e9 cumul\u00e9e de trois ans ou plus au cours des cinq derni\u00e8res ann\u00e9es ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Ne pas disposer d\u2019un niveau de qualification sup\u00e9rieur au certificat d\u2019\u00e9tudes de base ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Avoir suivi une formation au sein d\u2019un centre de formation et d\u2019insertion socioprofessionnelle adapt\u00e9 \u00e0 la suite de laquelle le centre a conclu \u00e0 un pronostic favorable d\u2019insertion socioprofessionnelle et ne pas \u00eatre parvenu \u00e0 trouver de l\u2019emploi \u00e0 l\u2019\u00e9ch\u00e9ance d\u2019un an apr\u00e8s la fin du suivi post formatif ;<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Avoir pr\u00e9sent\u00e9 au moins deux \u00e9checs en emploi ordinaire malgr\u00e9 la mise en place de primes de compensation, d\u2019am\u00e9nagements du poste de travail ou de contrats d\u2019adaptation professionnelle dans les cinq derni\u00e8res ann\u00e9es.<\/span><\/li><\/ul>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-7e902ae4 e-flex e-con-boxed e-con e-parent\" data-id=\"7e902ae4\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-7ea20444 e-con-full e-flex e-con e-child\" data-id=\"7ea20444\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6e9eb362 elementor-widget elementor-widget-heading\" data-id=\"6e9eb362\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Tu r\u00e9ponds aux crit\u00e8res ?<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-35473de2 elementor-widget elementor-widget-text-editor\" data-id=\"35473de2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>D\u00e9couvrez l&rsquo;ETA qui correspond \u00e0 votre projet professionnel et les m\u00e9tiers accessibles en ETA.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-df4a06b e-con-full e-flex e-con e-child\" data-id=\"df4a06b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-79379d59 elementor-mobile-align-right elementor-widget elementor-widget-button\" data-id=\"79379d59\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"\/annuaire-eta\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t<span class=\"elementor-button-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg>\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">D\u00e9couvrir les ETA<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2a203da1 elementor-mobile-align-right elementor-widget elementor-widget-button\" data-id=\"2a203da1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"\/secteur\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t<span class=\"elementor-button-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewBox=\"0 0 448 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"><\/path><\/svg>\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">D\u00e9couvrir les m\u00e9tiers et secteurs<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>Travailler en ETA Les Entreprises de Travail Adapt\u00e9 constituent souvent la principale opportunit\u00e9 d&rsquo;acc\u00e8s \u00e0 l&#8217;emploi pour les personnes en situation de handicap, tout en offrant un cadre d&rsquo;insertion sociale et d&rsquo;\u00e9panouissement professionnel optimal. D\u00e9couvrir les crit\u00e8res T\u00e9l\u00e9charger le PDF FALC Lire plus facilement Activez la version facile \u00e0 lire et \u00e0 comprendre (FALC). Version [&hellip;]<\/p>\n","protected":false},"author":62,"featured_media":5266918,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-5258521","page","type-page","status-publish","has-post-thumbnail","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/pages\/5258521","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/users\/62"}],"replies":[{"embeddable":true,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/comments?post=5258521"}],"version-history":[{"count":397,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/pages\/5258521\/revisions"}],"predecessor-version":[{"id":5267591,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/pages\/5258521\/revisions\/5267591"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/media\/5266918"}],"wp:attachment":[{"href":"https:\/\/leseta.be\/wp-json\/wp\/v2\/media?parent=5258521"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":5258287,"date":"2025-12-31T13:19:55","date_gmt":"2025-12-31T12:19:55","guid":{"rendered":"https:\/\/leseta.be\/?page_id=5258287"},"modified":"2026-07-14T14:03:42","modified_gmt":"2026-07-14T12:03:42","slug":"les-eta","status":"publish","type":"page","link":"https:\/\/leseta.be\/","title":{"rendered":"Les ETA"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"5258287\" class=\"elementor elementor-5258287\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3cf20e06 e-flex e-con-boxed e-con e-parent\" data-id=\"3cf20e06\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;video&quot;,&quot;background_video_link&quot;:&quot;https:\\\/\\\/leseta.be\\\/wp-content\\\/uploads\\\/2026\\\/04\\\/Video-leseta-1.mp4&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-background-video-container elementor-hidden-mobile\">\n\t\t\t\t\t\t\t<video class=\"elementor-background-video-hosted\" role=\"presentation\" autoplay muted playsinline loop><\/video>\n\t\t\t\t\t<\/div><div class=\"elementor-element elementor-element-75a81a26 e-con-full e-flex e-con e-child\" data-id=\"75a81a26\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6f30f1fc elementor-widget elementor-widget-heading\" data-id=\"6f30f1fc\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">Trouvez l\u2019entreprise adapt\u00e9e \u00e0 votre besoin<\/h1>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3c3a9dbb elementor-widget__width-inherit elementor-widget elementor-widget-text-editor\" data-id=\"3c3a9dbb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p class=\"hero-subtitle\">Des solutions professionnelles sur mesure, port\u00e9es par les entreprises de travail adapt\u00e9<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9cfda78 elementor-mobile-align-left elementor-widget element